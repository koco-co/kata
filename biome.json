{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnsafeOptionalChaining": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noImplicitAnyLet": "error",
        "noAssignInExpressions": "error",
        "noTemplateCurlyInString": "warn",
        "noRedeclare": "error",
        "noFallthroughSwitchClause": "error"
      },
      "complexity": {
        "noUselessStringRaw": "warn"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.json",
      "!!**/node_modules",
      "!!workspace",
      "!!.claude/worktrees",
      "!!.worktrees",
      "!!**/.venv",
      "!!**/*.md",
      "!!**/*.hbs",
      "!!**/*.fixture.ts",
      "!!**/settings.local.json"
    ],
    "ignoreUnknown": true
  }
}
