{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FeatureSourceSnapshot@2",
  "type": "object",
  "required": [
    "schema",
    "feature_id",
    "sources",
    "required_source_kinds",
    "confirmed_source_repos"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "FeatureSourceSnapshot@2" },
    "feature_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_ref"],
        "additionalProperties": false,
        "properties": {
          "source_ref": {
            "type": "string",
            "pattern": "^(?:prd\\.file|command\\.output|knowledge\\.entry|repo\\.line|case\\.archive|workspace\\.config|lanhu\\.fixture|design\\.screenshot|user\\.confirmation):.+#sha256:[a-f0-9]{64}$"
          },
          "path": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "required_source_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "prd.file",
          "command.output",
          "knowledge.entry",
          "repo.line",
          "case.archive",
          "workspace.config",
          "lanhu.fixture",
          "design.screenshot",
          "user.confirmation"
        ]
      }
    },
    "confirmed_source_repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group", "project", "branch"],
        "additionalProperties": false,
        "properties": {
          "group": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["frontend", "backend"] }
        }
      }
    },
    "slug_source": { "type": "string" }
  }
}
