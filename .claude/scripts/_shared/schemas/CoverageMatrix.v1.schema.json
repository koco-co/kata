{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CoverageMatrix@1",
  "type": "object",
  "required": [
    "schema_ref",
    "id",
    "title",
    "coverage_type",
    "requirement_atom_ids",
    "risk_level",
    "evidence_status",
    "manual_case_allowed",
    "automation_allowed"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_ref": { "type": "string", "const": "CoverageMatrix@1" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "coverage_type": { "type": "string" },
    "requirement_atom_ids": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "type": "string" },
    "evidence_status": { "type": "string" },
    "manual_case_allowed": { "type": "boolean" },
    "automation_allowed": { "type": "boolean" }
  }
}
