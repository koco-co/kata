{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CaseEvidenceMap@1",
  "type": "object",
  "required": [
    "schema_ref",
    "case_id",
    "case_title",
    "requirement_atom_ids",
    "coverage_matrix_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_ref": { "type": "string", "const": "CaseEvidenceMap@1" },
    "case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "case_title": { "type": "string", "minLength": 1 },
    "requirement_atom_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "coverage_matrix_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
