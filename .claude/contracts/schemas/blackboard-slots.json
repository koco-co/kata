{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kata.local/schemas/blackboard-slots.json",
  "title": "Blackboard Slot Registry",
  "description": "Declared blackboard slots. v2 workflows must reference only slots in this registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v1_legacy", "v2"],
  "properties": {
    "v1_legacy": {
      "type": "array",
      "description": "Original 8 slots from .claude/contracts/blackboard/state-model.md.",
      "items": { "type": "string" },
      "const": [
        "sources",
        "source_refs",
        "decisions",
        "open_questions",
        "artifacts",
        "coverage",
        "verification",
        "handoff"
      ]
    },
    "v2": {
      "type": "array",
      "description": "v2 slots covering spec §6.8 case-draft + §6.12 defect-analyze + remaining 6 skills.",
      "items": { "type": "string" },
      "const": [
        "user_input",
        "source_refs",
        "atoms",
        "draft_archive",
        "spec_verdict",
        "spec_violations",
        "quality_verdict",
        "quality_violations",
        "archive_path",
        "xmind_path",
        "manifest_path",
        "mode",
        "severity",
        "category",
        "scope",
        "root_cause",
        "evidence_refs",
        "impacted_areas",
        "side_a_intent",
        "side_b_intent",
        "resolution_plan",
        "defect_report_path",
        "conflict_resolution_plan_path",
        "bug_record",
        "fix_scope",
        "hotfix_archive_path",
        "probe_result",
        "diagnosis",
        "remediation_plan",
        "knowledge_entry_path",
        "kb_query",
        "kb_match",
        "kb_write_path",
        "workspace_request",
        "workspace_state",
        "env_profile",
        "qa_cases",
        "playwright_tests",
        "run_handoff",
        "ui_evidence"
      ]
    }
  }
}
