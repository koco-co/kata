      "runsVerify": [{ "pattern": "kata runs verify", "file": "workflows/deliver.md" }],
      "coverageCmd": [{ "pattern": "kata automation coverage", "file": "workflows/deliver.md" }],
      "lintGate": [
        { "pattern": "kata automation lint", "file": "workflows/deliver.md" },
        { "pattern": "--exit-code", "file": "workflows/deliver.md" },
        { "pattern": "--shared", "file": "workflows/deliver.md" }
      ],
      "caseNaming": [{ "pattern": "c<四位序号>-<英文slug>.spec.ts", "file": "SKILL.md" }],
      "noMockBusinessApi": [{ "pattern": "mock", "file": "references/playwright-api.md" }],
      "cookieBoundary": [{ "pattern": "config/env/", "file": "SKILL.md" }]
    },
    "defect-analyze": {
      "reportPath": [{ "pattern": "analyses/", "file": "SKILL.md" }],
      "reportFormat": [{ "pattern": "report.md", "file": "SKILL.md" }],
      "fourModes": [
        { "pattern": "bug", "file": "SKILL.md" },
        { "pattern": "conflict", "file": "SKILL.md" },
        { "pattern": "scan", "file": "SKILL.md" },
        { "pattern": "hotfix", "file": "SKILL.md" }
