        { "pattern": "hosts.yaml", "file": "SKILL.md" },
        { "pattern": "data_sources.yaml", "file": "SKILL.md" }
      ],
      "inspectCmd": [
        { "pattern": "kata infra inspect", "file": "SKILL.md" },
        { "pattern": "connectivity", "file": "SKILL.md" }
      ],
      "credentialSet": [
        { "pattern": "kata infra credentials set", "file": "SKILL.md" },
        { "pattern": "--username", "file": "SKILL.md" }
      ],
      "hostTrust": [
        { "pattern": "kata infra trust-host", "file": "SKILL.md" },
        { "pattern": "fingerprint", "file": "SKILL.md" }
      ],
      "reportPath": [{ "pattern": "infra-report/<yyyymm>/<slug>.md", "file": "SKILL.md" }],
      "lintGate": [{ "pattern": "kata infra lint", "file": "SKILL.md" }],
      "ssh2Boundary": [
        { "pattern": "ssh2", "file": "SKILL.md" },
        { "pattern": "任意远程命令", "file": "SKILL.md" }
      ]
    },
    "domain-knowledge": {
      "readCmd": [{ "pattern": "knowledge read", "file": "SKILL.md" }],
      "writeCmd": [{ "pattern": "knowledge write", "file": "SKILL.md" }],
      "statusFlag": [{ "pattern": "--status", "file": "SKILL.md" }],
      "fourStates": [
        { "pattern": "verified", "file": "SKILL.md" },
        { "pattern": "observed", "file": "SKILL.md" },
        { "pattern": "conflicting", "file": "SKILL.md" },
        { "pattern": "deprecated", "file": "SKILL.md" }
      ],
      "knowledgeDir": [{ "pattern": "workspace/<project>/knowledge/", "file": "SKILL.md" }]
    },
    "workspace-management": {
      "scanCmd": [{ "pattern": "kata project scan", "file": "SKILL.md" }],
      "createCmd": [{ "pattern": "kata project create", "file": "SKILL.md" }],
      "dryRun": [{ "pattern": "--dry-run", "file": "SKILL.md" }],
      "confirmed": [{ "pattern": "--confirmed", "file": "SKILL.md" }]
    }
