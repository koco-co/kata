        { "pattern": "observed", "file": "workflows/write.md" },
        { "pattern": "conflicting", "file": "workflows/write.md" },
        { "pattern": "deprecated", "file": "workflows/write.md" }
      ],
      "knowledgeDir": [{ "pattern": "workspace/<project>/knowledge/", "file": "SKILL.md" }]
