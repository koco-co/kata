      "createTableRule": [{ "pattern": "CREATE TABLE", "file": "examples/cases.yaml" }],
      "resolveCmd": [{ "pattern": "kata features resolve", "file": "workflows/create.md" }],
      "standingFlag": [{ "pattern": "--standing", "file": "workflows/create.md" }]
