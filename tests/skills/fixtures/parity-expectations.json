{
  "comment": "单源业务声明矩阵:每条 pattern 绑定到 .claude/skills/<skill>/ 内的具体文件,契约测试只读取该文件断言;另由契约测试检查 .agents/skills -> ../.claude/skills 的 symlink shape。",
  "skills": {
    "test-case": {
      "formalSource": [{ "pattern": "cases/需求名.yaml", "file": "SKILL.md" }],
      "derivatives": [
        { "pattern": "kata cases build", "file": "workflows/create.md" },
        { "pattern": "需求名.xmind", "file": "SKILL.md" }
      ],
      "lintGate": [{ "pattern": "kata cases lint", "file": "SKILL.md" }],
      "noPendingConfirm": [{ "pattern": "待确认", "file": "workflows/create.md" }],
      "prdAuthority": [
        { "pattern": "prd/prd.md", "file": "SKILL.md" },
        { "pattern": "kata prd finalize", "file": "workflows/create.md" },
        { "pattern": "publish_confirmed", "file": "workflows/create.md" }
      ],
      "featurePathFormat": [
        { "pattern": "<项目>:<版本目录>/<需求目录名>", "file": "workflows/create.md" }
      ],
      "testPoints": [{ "pattern": "cases/test-points.md", "file": "SKILL.md" }],
      "placeholders": [
        { "pattern": "${DataSourceA}", "file": "examples/cases.yaml" },
        { "pattern": "${SchemaA}", "file": "prompts/worker.md" }
