      "completionAllure": [{ "pattern": "Allure", "file": "SKILL.md" }],
      "completionBizRecord": [{ "pattern": "业务记录", "file": "SKILL.md" }],
      "handoff": [{ "pattern": "handoff.md", "file": "workflows/deliver.md" }],
      "envRun": [{ "pattern": "kata env run", "file": "workflows/implement.md" }],
      "envList": [{ "pattern": "kata env list", "file": "SKILL.md" }],
      "defaultEnv": [{ "pattern": "ltqc-local", "file": "SKILL.md" }],
      "scaffold": [{ "pattern": "kata automation scaffold", "file": "workflows/prepare.md" }],
      "runsNew": [{ "pattern": "kata runs new", "file": "SKILL.md" }],
