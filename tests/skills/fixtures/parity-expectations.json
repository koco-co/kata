        { "pattern": "fingerprint", "file": "references/playbook.md" }
      ],
      "defaultCredentials": [
        { "pattern": "server-default", "file": "references/playbook.md" },
        { "pattern": "data-source-default", "file": "references/playbook.md" }
      ],
      "reportPath": [
        { "pattern": "infra-report/<yyyymm>/<slug>.md", "file": "references/playbook.md" }
      ],
      "lintGate": [{ "pattern": "kata infra lint", "file": "references/playbook.md" }],
      "ssh2Boundary": [
        { "pattern": "ssh2", "file": "SKILL.md" },
        { "pattern": "任意远程命令", "file": "SKILL.md" }
      ]
    },
    "domain-knowledge": {
      "readCmd": [{ "pattern": "knowledge read", "file": "workflows/read.md" }],
      "writeCmd": [{ "pattern": "knowledge write", "file": "workflows/write.md" }],
      "statusFlag": [{ "pattern": "--status", "file": "workflows/read.md" }],
      "fourStates": [
