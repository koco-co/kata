        { "pattern": "request-api", "file": "references/executor-contract.md" },
        { "pattern": "midscene-web-ui", "file": "references/executor-contract.md" },
        { "pattern": "midscene-app-ui", "file": "references/executor-contract.md" }
      ],
      "lifecycle": [
        { "pattern": "kata automation setup", "file": "workflows/prepare.md" },
        { "pattern": "kata automation doctor", "file": "workflows/prepare.md" },
