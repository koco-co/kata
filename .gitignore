# Dependencies and local secrets
node_modules
package-lock.json
.env
.env.envs
.env.local
config.json
.venv/
# Private runtime config root: everything under config/private/ is local-only.
# Tracked config lives in config/policies/ and config/examples/.
/config/private/

# Hidden runtime root
.kata/
**/.kata/
.worktrees/

# Claude Code scheduled-tasks runtime lock (session/pid-specific, never tracked)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Feature runtime products
/runs/
/artifacts/
workspace/*/features/**/.process/
workspace/*/features/**/runs/
workspace/*/.state/
workspace/*/features/**/.debug/
# Cases exports are deterministic build products; keep the YAML as the only tracked source.
workspace/*/features/**/cases/exports/**
allure-results/
/allure-report/
test-results/
output/

# System and build
**/.DS_Store
*.pyc
__pycache__/
*.log
dist/
*.tsbuildinfo
.tide/
**/tmp/

# Local agent tooling (not part of kata, kept local-only)
.codegraph/
.repos/

# Runtime traces and Office temp lock files
.playwright-cli/
**/~$*

# Untracked binary junk in feature imports (repo-policy rejects these anyway)
workspace/*/features/**/cases/imports/*.zip
