# Dependencies and local secrets
node_modules
package-lock.json
.env
.env.envs
.env.local
# One migration-cycle fallback; migrate-dataassets removes verified legacy Cookie files.
workspace/*/_shared/env/.local/
/config/env/
# SSH 凭据(infra-diagnose),与 config/env 同级本机私密配置
/config/infra/
config.json
config/repo-branch-mapping.yaml

# Hidden runtime root
.kata/
**/.kata/
.worktrees/

# Claude Code scheduled-tasks runtime lock (session/pid-specific, never tracked)
.claude/scheduled_tasks.lock

# Feature runtime products
workspace/*/features/**/.process/
workspace/*/features/**/runs/
workspace/*/features/**/.debug/
workspace/*/features/**/scheduler_restart.curl
.playwright-cli/*.yml
allure-results/
output/
**/.runs/test-results/

# System and build
**/.DS_Store
*.pyc
__pycache__/
*.log
dist/
*.tsbuildinfo
.tide/
**/tmp/

# Local agent tooling (not part of kata, kept local-only)
.codegraph/
.repos/
