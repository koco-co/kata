# Dependencies and local secrets
node_modules
package-lock.json
.env
config.json
# Private runtime config root: everything under config/private/ is local-only.
# Tracked config lives in config/policies/, config/examples/ and config/automation/.
/config/private/

# Hidden runtime root
.kata/
**/.kata/
.worktrees/

# Claude Code scheduled-tasks runtime lock (session/pid-specific, never tracked)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Feature runtime products
workspace/*/features/**/.process/
workspace/*/features/**/runs/
workspace/*/.state/
workspace/*/features/**/.debug/
allure-results/
/allure-report/
test-results/
output/

# System and build
**/.DS_Store
*.pyc
__pycache__/
*.log
dist/
*.tsbuildinfo
.tide/
**/tmp/

# Local agent tooling (not part of kata, kept local-only)
.codegraph/
.repos/
