# Dependencies and local secrets
node_modules
package-lock.json
.env
.env.envs
.env.local
/config/env/*
!/config/env/env.example.yaml
# Source repository topology is local-only; commit only the redacted template.
/config/repos/sources.yaml
# Infrastructure topology and credentials are local; only unusable examples are tracked.
/config/infra/*
!/config/infra/
!/config/infra/*.example.yaml
# Plugin endpoints and credentials are local; only redacted examples are tracked.
/config/plugin/*
!/config/plugin/
!/config/plugin/*.example.yaml
config.json

# Hidden runtime root
.kata/
**/.kata/
.worktrees/

# Claude Code scheduled-tasks runtime lock (session/pid-specific, never tracked)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Feature runtime products
workspace/*/features/**/.process/
workspace/*/features/**/runs/
workspace/*/.state/
workspace/*/features/**/.debug/
workspace/*/features/**/scheduler_restart.curl
.playwright-cli/*.yml
allure-results/
/allure-report/
test-results/
output/

# System and build
**/.DS_Store
*.pyc
__pycache__/
*.log
dist/
*.tsbuildinfo
.tide/
**/tmp/

# Local agent tooling (not part of kata, kept local-only)
.codegraph/
.repos/
