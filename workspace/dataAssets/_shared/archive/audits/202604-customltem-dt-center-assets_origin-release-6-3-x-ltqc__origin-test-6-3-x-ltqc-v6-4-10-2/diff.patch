@@ -0,0 +1,259 @@
+package com.dtstack.assets.controller.valid;
+
+import com.dtstack.assets.common.auth.AuthFunction;
+import com.dtstack.assets.conf.ApiPath;
+import com.dtstack.assets.model.valid.vo.JsonValidationConfigVo;
+import com.dtstack.assets.response.AssetsTemplate;
+import com.dtstack.assets.service.data.vo.ImportDataResultVO;
+import com.dtstack.assets.service.valid.impl.JsonValidationConfigService;
+import com.dtstack.assets.service.valid.param.jsonformat.*;
+import com.dtstack.dtcenter.common.pager.PageResult;
+import dt.insight.plat.autoconfigure.web.security.permissions.annotation.Security;
+import dt.insight.plat.lang.base.Checks;
+import dt.insight.plat.lang.exception.biz.BizException;
+import dt.insight.plat.lang.web.R;
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.multipart.MultipartFile;
+
+import javax.annotation.Resource;
+import javax.servlet.http.HttpServletResponse;
+import java.util.Arrays;
+import java.util.List;
+
+import static com.dtstack.assets.common.consts.DataSourceTypeEnum.*;
+
+/**
+ * json配置格式
+ */
+@RestController
+@RequestMapping(value = ApiPath.API_VALID_PATH + "/jsonValidationConfig")
+public class JsonValidationConfigController {
+
+    private static final List<Integer> DATASOURCE_TYPE_LIST = Arrays.asList(SparkThrift2_1.getValue(),Hive2.getValue(),DORIS3X.getValue());
+
+    @Resource
+    private JsonValidationConfigService jsonValidationConfigService;
+
+    /**
+     * 条件匹配查询树型结构（全量）
+     * @param param
+     * @return
+     */
+    @PostMapping(value = "/getTree")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_VIEW)
+    public R<List<JsonValidationConfigVo>> getAllTreeStructures(@RequestBody JsonFormatQueryParam param) {
+
+        return new AssetsTemplate<List<JsonValidationConfigVo>>() {
+            @Override
+            protected List<JsonValidationConfigVo> process() throws BizException {
+                return jsonValidationConfigService.queryTreeByJsonKey(param.getSearch(),param.getDataSourceType());
+            }
+        }.execute();
+    }
+
+
+
+    @PostMapping(value = "/getTreeByPage")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_VIEW)
+    public R<PageResult<List<JsonValidationConfigVo>>> getAllTreePage(@RequestBody JsonFormatQueryParam param) {
+
+        return new AssetsTemplate<PageResult<List<JsonValidationConfigVo>>>() {
+            @Override
+            protected PageResult<List<JsonValidationConfigVo>> process() throws BizException {
+                return jsonValidationConfigService.queryTreePageByJsonKey(param.getSearch(),param.getDataSourceType(), param.getCurrentPage(), param.getPageSize());
+            }
+        }.execute();
+    }
+
+
+
+    /**
+     * 删除
+     * @param param
+     * @return
+     */
+    @PostMapping(value = "/delete")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_OPERATION)
+    public R<Boolean> deleteJsonFormat(@RequestBody JsonFormatDeleteParam param) {
+
+        return new AssetsTemplate<Boolean>() {
+            @Override
+            protected void checkParams() throws IllegalArgumentException {
+                Checks.nonNull(param.getId(), "Id 不能为空");
+            }
+
+            @Override
+            protected Boolean process() throws BizException {
+                return jsonValidationConfigService.deleteById(param.getId());
+            }
+        }.execute();
+    }
+
+
+    /**
+     * 批量删除
+     * @param param
+     * @return
+     */
+    @PostMapping(value = "/deleteBatch")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_OPERATION)
+    public R<Boolean> deleteJsonFormatBatch(@RequestBody JsonFormatDeleteParam param) {
+
+        return new AssetsTemplate<Boolean>() {
+            @Override
+            protected void checkParams() throws IllegalArgumentException {
+                Checks.nonNull(param.getId(), "Id 不能为空");
+            }
+
+            @Override
+            protected Boolean process() throws BizException {
+                return jsonValidationConfigService.deleteBatchByIds(param.getIds());
+            }
+        }.execute();
+    }
+
+    /**
+     * 新增
+     * @param param
+     * @return
+     */
+    @PostMapping(value = "/add")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_OPERATION)
+    public R<Boolean> addJsonFormat(@RequestBody JsonFormatAddOrUpdateParam param) {
+
+        return new AssetsTemplate<Boolean>() {
+            @Override
+            protected void checkParams() throws IllegalArgumentException {
+                String jsonKey = param.getJsonKey();
+                Checks.nonNull(jsonKey, "jsonKey 为必填项");
+                Checks.isFalse(jsonKey.length() > 255, "jsonKey 长度不能超过 255 个字符");
+                String name = param.getName();
+                Checks.isFalse(StringUtils.isNotBlank(name) && name.length() > 255, "name 长度不能超过 255 个字符");
+                String value = param.getValue();
+                Checks.isFalse(StringUtils.isNotBlank(value) && value.length() > 255, "value 长度不能超过 255 个字符");
+                Integer datasourceType = param.getDataSourceType();
+                Checks.nonNull(datasourceType, "datasourceType 为必填项");
+                Checks.isFalse(!DATASOURCE_TYPE_LIST.contains(datasourceType), "数据源类型只允许sparkThrift2.x,hive2.x,doris3.x");
+            }
+
+            @Override
+            protected Boolean process() throws BizException {
+                return jsonValidationConfigService.insert(param);
+            }
+        }.execute();
+    }
+
+    /**
+     * 修改
+     * @param param
+     * @return
+     */
+    @PostMapping(value = "/update")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_OPERATION)
+    public R<Boolean> updateJsonFormat(@RequestBody JsonFormatAddOrUpdateParam param) {
+
+        return new AssetsTemplate<Boolean>() {
+            @Override
+            protected void checkParams() throws IllegalArgumentException {
+                Checks.nonNull(param, "参数不能为空");
+                String jsonKey = param.getJsonKey();
+                Checks.nonNull(jsonKey, "jsonKey 为必填项");
+                Checks.isFalse(jsonKey.length() > 255, "jsonKey 长度不能超过 255 个字符");
+                String name = param.getName();
+                Checks.isFalse(StringUtils.isNotBlank(name) && name.length() > 255, "name 长度不能超过 255 个字符");
+                String value = param.getValue();
+                Checks.isFalse(StringUtils.isNotBlank(value) && value.length() > 255, "value 长度不能超过 255 个字符");
+                Integer datasourceType = param.getDataSourceType();
+                Checks.nonNull(datasourceType, "datasourceType 为必填项");
+                Checks.isFalse(!DATASOURCE_TYPE_LIST.contains(datasourceType), "数据源类型只允许sparkThrift2.x,hive2.x,doris3.x");
+            }
+
+            @Override
+            protected Boolean process() throws BizException {
+                return jsonValidationConfigService.update(param);
+            }
+        }.execute();
+    }
+
+
+    /**
+     * 导出数据
+     * @param param
+     * @param response
+     */
+    @PostMapping(value = "/export")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_VIEW)
+    public void exportJsonFormat(@RequestBody JsonFormatExportParam param, HttpServletResponse response) {
+        new AssetsTemplate<Void>() {
+
+            @Override
+            protected Void process() throws BizException {
+                jsonValidationConfigService.exportJsonFormat(param,response);
+                return null;
+            }
+        }.execute();
+    }
+
+    @PostMapping(value = "/downloadTemplate")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_VIEW)
+    public void downloadConfigTemplate(@RequestBody(required = false) JsonFormatExportParam param,HttpServletResponse response) {
+        jsonValidationConfigService.downloadTemplate(response);
+    }
+
+
+    /**
+     * 导入数据
+     * @param param
+     * @param file
+     * @return
+     */
+    @PostMapping(value = "/import")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_OPERATION)
+    public R<ImportDataResultVO> importJsonFormat(JsonFormatImportParam param, MultipartFile file) {
+        return new AssetsTemplate<ImportDataResultVO>() {
+            @Override
+            protected void checkParams() throws IllegalArgumentException {
+                Checks.nonNull(file, "导入文件不能为空");
+            }
+
+            @Override
+            protected ImportDataResultVO process() throws BizException {
+                return jsonValidationConfigService.importJsonFormat(file,param.getDataSourceType(),param.getRepeatMode());
+            }
+        }.execute();
+    }
+
+
+
+    /**
+     * 导出错误数据
+     * @param param
+     * @return
+     */
+    @PostMapping(value = "/importError")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_OPERATION)
+    public void importJsonFormatError(HttpServletResponse response,@RequestBody JsonFormatErrorDataParam param) {
+        jsonValidationConfigService.exportErrorData(response, param);
+    }
+
+
+    @PostMapping(value = "/getValidContent")
+    @Security(code = AuthFunction.DATAVALID_GENERALCONFIG_JSONVALIDATIONCONFIG_VIEW)
+    public R<String> getValidContent(@RequestBody JsonFormatExportParam param) {
+        return new AssetsTemplate<String>() {
+            @Override
+            protected void checkParams() throws IllegalArgumentException {
+                Checks.nonNull(param, "参数不能为空");
+                Checks.nonNull(param.getIds(), "参数不能为空");
+            }
+
+            @Override
+            protected String process() throws BizException {
+                return jsonValidationConfigService.getValidContent(param.getIds());
+            }
+        }.execute();
+    }
+
+
+}
