+        KeyRangeValid keyRangeValid = JSON.parseObject(expansion, KeyRangeValid.class);
+        List<Long> ids = keyRangeValid.getIdList();
+        Integer isAll = keyRangeValid.getIsAll();
+        List<JsonValidationConfig> jsonValidationConfigs;
+        //查询全部
+        if(CollectionUtils.isEmpty(ids) && isAll == 1){
+            LambdaQueryWrapper<JsonValidationConfig> queryWrapper = new LambdaQueryWrapper<>();
+            queryWrapper.eq(JsonValidationConfig::getDataSourceType, functionBO.getSource().getType());
+            jsonValidationConfigs = jsonValidationConfigService.getBaseMapper().selectList(queryWrapper);
+        }else {
+            jsonValidationConfigs = jsonValidationConfigService.selectFullPathByIds(ids);
+        }
+        Integer include = keyRangeValid.getInclude();
+        String jsonKey = analysisKey(jsonValidationConfigs);
+        String verifySQL = super.generatorDirtySQL(sqlOperator, schemaTableUtil, functionBO);
+        return verifySQL.replace(JSON_KEY_PLACEHOLDER,jsonKey)
+                .replace(INCLUDE_PLACEHOLDER,include.toString())
+                .replace(UNIQUE_PLACEHOLDER, JOB_ID);
+    }
+
+    @Override
+    public String executorBefore(Integer dataSourceType) {
+        String udfName = UDF_NAME + JOB_ID;
+        if (HIVE_UDF_DATASOURCE.contains(dataSourceType)) {
+            return String.format(HIVE_UDF_TEMPALTE, udfName, udfName, UDF_CLASS_PATH, udfHdfsPath);
+        }
+        return null;
+    }
+
+    /**
+     * 全路径中拼接参数
+     * @param key
+     * @return
+     */
+    private String analysisKey(List<JsonValidationConfig> key){
+        if (key == null || key.isEmpty()) {
+            return "'[]'";
+        }
+
+        StringBuilder stringBuilder = new StringBuilder();
+        stringBuilder.append("\"[");
+
+        for (int i = 0; i < key.size(); i++) {
+            stringBuilder.append("\\");
+            stringBuilder.append("\"$");
+            stringBuilder.append(key.get(i).getFullPath());
+            stringBuilder.append("\\");
+            stringBuilder.append("\"");
+
+            if (i < key.size() - 1) {
+                stringBuilder.append(", ");
+            }
+        }
+
+        stringBuilder.append("]\"");
+        return stringBuilder.toString();
+    }
+
+    @Override
+    public Boolean checkRulePass(CheckRulePassDTO checkRulePass) {
+        return Objects.nonNull(checkRulePass.getCountValue()) && checkRulePass.getCountValue() == 0;
+    }
+}
