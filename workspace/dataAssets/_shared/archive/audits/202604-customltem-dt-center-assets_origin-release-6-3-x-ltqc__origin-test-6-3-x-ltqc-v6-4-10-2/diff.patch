+        } else {
+            dirtyTableName = iSqlOperator.getCompleteCusDirtyTableName(dataSource, table.getCatalogName(), table.getSchemaName(), rule.getId(), replacement);
+        }
+
+        IClient client = ClientCache.getClient(dataSource.getType());
+
+        ISourceDTO sourceDTO = iSqlOperator.withKerberosSourceLoad(dataSource);
+
+        String selectSql = String.format("select * from %s limit 100",dirtyTableName);
+
+        log.info("查询格式化临时表数据，dataSourceType={},selectSql={}", dataSource.getType(), selectSql);
+        SqlQueryDTO queryDTO = SqlQueryDTO.builder().sql(selectSql).build();
+        List<Map<String, Object>> maps = client.executeQuery(sourceDTO, queryDTO);
+
+        List<Map<String, Object>> result = new ArrayList<>();
+        if (Langs.isNotEmpty(maps)){
+
+            Map<String,String> tableAliasMap = getVerifyTableAlias(table.getSchemaName(),table.getTableName(),table.getSchemaName(),table.getTableName(),config);
+            // 生成反向映射：Alias -> CompleteTableName
+            Map<String, String> aliasToTableMap = tableAliasMap.entrySet().stream()
+                    .collect(Collectors.toMap(
+                            Map.Entry::getValue,
+                            Map.Entry::getKey,
+                            (k1, k2) -> k2
+                    ));
+
+            for (Map<String, Object> row : maps) {
+                Map<String,Object> rowLinkMap = new LinkedHashMap<>(row.size());
+                row.forEach((k,v)->{
+                    String columnName = k;
+                    if (columnName.contains("\\.")){
+                        columnName = columnName.split("\\.")[0];
+                    }
+                    //查询字段别号还原成原表名
+                    for (Map.Entry<String, String> tableAlias:aliasToTableMap.entrySet()){
