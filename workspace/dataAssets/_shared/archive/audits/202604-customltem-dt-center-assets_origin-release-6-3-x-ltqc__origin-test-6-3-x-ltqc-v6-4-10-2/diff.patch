+
+    /**
+     * 查询所有数据(树形结构)
+     * @return
+     */
+    public List<JsonValidationConfigVo> buildTreeStructures() {
+        LambdaQueryWrapper<JsonValidationConfig> queryWrapper = new LambdaQueryWrapper<>();
+        queryWrapper.eq(JsonValidationConfig::getProjectId, MetaObjectHolder.projectId());
+        // 1. 查询所有记录
+        List<JsonValidationConfigVo> allNodes = jsonValidationConfigDao.selectList(queryWrapper)
+                .stream().map(JsonValidationConfigVo::build).collect(Collectors.toList());
+
+        // 2. 构建节点映射
+        Map<Long, JsonValidationConfigVo> nodeMap = new HashMap<>();
+        List<JsonValidationConfigVo> roots = new ArrayList<>();
+
+        for (JsonValidationConfigVo node : allNodes) {
+            nodeMap.put(node.getId(), node);
+            // 找出所有根节点（parentId 为 null 或 0 的节点）
+            if (node.getParentId() == 0) {
+                roots.add(node);
+            }
+        }
+
+        // 3. 构建父子关系
+        for (JsonValidationConfigVo node : allNodes) {
+            if (node.getParentId() != null && node.getParentId() != 0) {
+                JsonValidationConfigVo parent = nodeMap.get(node.getParentId());
+                if (parent != null) {
+                    if (parent.getChildren() == null) {
+                        parent.setChildren(new ArrayList<>());
+                    }
+                    parent.getChildren().add(node);
+                }
+            }
+        }
+
+        return roots;
+    }
