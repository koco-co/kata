+
+        String uniqueKey = UUID.randomUUID().toString().replace("-", "").substring(0, 20);
+        String importErrorSftpDirPath = ImportDataUtil.buildSftpDirPath(uniqueKey);
+        String importErrorLocalDirPath = ImportDataUtil.buildLocalDirPath(uniqueKey);
+        String importErrorLocalFilePath = importErrorLocalDirPath + File.separator + String.format("json_format_error_%s.xlsx", new SimpleDateFormat("yyyyMMdd").format(new Date()));
+        ImportDataResultVO importDataResultVO = new ImportDataResultVO();
+
+        // 核心错误收集器：Map<Sheet索引, Map<行号, Map<列号, 错误信息>>>
+        Map<Integer, Map<Integer, Map<Integer, String>>> globalErrorMap = new HashMap<>();
+
+        try (InputStream initStream = file.getInputStream();
+             com.alibaba.excel.ExcelReader excelReader = EasyExcelFactory.read(initStream).build()) {
+            List<ReadSheet> sheetNames = excelReader.excelExecutor().sheetList();
+            importParamCheck(sheetNames);
+
+            Map<String, Long> mainKeyToIdMap = new HashMap<>();
+            // 用于记录所有已经成功的全路径，供子表校验父层级
+            Set<String> validFullPathSet = new HashSet<>();
+
+            for (int i = 0; i < sheetNames.size(); i++) {
+                String sheetName = sheetNames.get(i).getSheetName();
+                InputStream currentStream = file.getInputStream();
+
+                // 初始化当前 Sheet 的错误收集器
+                Map<Integer, Map<Integer, String>> currentSheetErrors = new HashMap<>();
+                globalErrorMap.put(i, currentSheetErrors);
+
+                List<JsonValidationConfig> dataList = new ArrayList<>();
+
+                if (i == 0) {
+                    readMainSheet(currentStream, sheetName, datasourceType, mainKeyToIdMap, validFullPathSet, dataList, currentSheetErrors,repeatMode);
+                } else {
+                    // 统一处理 1~4 层子表
+                    readSubSheet(currentStream, sheetName, datasourceType, mainKeyToIdMap, validFullPathSet, dataList, currentSheetErrors, i,repeatMode);
+                }
+                currentStream.close();
+            }
+
+            // 全部解析完毕后，判断是否有错误
+            boolean hasErrors = globalErrorMap.values().stream().anyMatch(map -> !map.isEmpty());
+            transactionTemplate.execute(status -> {
+                if (hasErrors) {
+                    // 生成错误文件
+                    try (InputStream errorStream = file.getInputStream()) {
+                        ExcelErrorCommentWriter.writeErrorComments(errorStream, globalErrorMap, importErrorLocalFilePath);
