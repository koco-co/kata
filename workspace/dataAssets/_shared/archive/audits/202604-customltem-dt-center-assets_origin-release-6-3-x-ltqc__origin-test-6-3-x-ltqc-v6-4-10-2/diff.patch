+package com.dtstack.assets.service.valid.rule;
+
+import com.alibaba.fastjson.JSON;
+import com.alibaba.fastjson.JSONObject;
+import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
+import com.dtstack.assets.model.valid.JsonValidationConfig;
+import com.dtstack.assets.service.valid.impl.JsonValidationConfigService;
+import dt.insight.boot.authz.MetaObjectHolder;
+import org.apache.commons.collections.CollectionUtils;
+import org.springframework.stereotype.Component;
+
+import javax.annotation.Resource;
+import java.util.*;
+import java.util.stream.Collectors;
+
+/**
+ * @author kavensp
+ */
+@Component("enumValue46")
+public class KeyRangeTemplateHandler extends AbstractTemplateHandler {
+
+    private static final String KEY_PATH = "keyPath";
+
+    private static final String INCLUDE = "include";
+
+    @Resource
+    private JsonValidationConfigService jsonValidationConfigService;
+
+    @Override
+    public Map<String, Object> getPassTemplateParams(TemplateParam templateParam) {
+        String ruleExpansion = templateParam.getRuleExpansion();
+        JSONObject jsonObject = JSON.parseObject(ruleExpansion);
+        List<Long> keyIds = jsonObject.getJSONArray("idList").toJavaList(Long.class);
+        Integer isAll = jsonObject.getInteger("isAll");
+        LambdaQueryWrapper<JsonValidationConfig> queryWrapper = new LambdaQueryWrapper<>();
+        if(isAll == 1 && CollectionUtils.isEmpty(keyIds)){
+            Integer dataSourceType = jsonObject.getInteger("dataSourceType");
+            queryWrapper.eq(JsonValidationConfig::getDataSourceType, dataSourceType);
+            queryWrapper.eq(JsonValidationConfig::getProjectId, MetaObjectHolder.projectId());
+        }else {
+            queryWrapper.in(JsonValidationConfig::getId, keyIds);
+        }
+        List<JsonValidationConfig> jsonValidationConfigs = jsonValidationConfigService.getBaseMapper().selectList(queryWrapper);
+        String include = jsonObject.getInteger(INCLUDE)==1?"包含":"不包含";
+        String keyPath = JsonValidationConfigService.buildKeyPath(jsonValidationConfigs);
+
+        Map<String, Object> templateParams = new HashMap<>();
+        templateParams.put(INCLUDE, include);
+        templateParams.put(KEY_PATH, keyPath);
+        return templateParams;
+    }
+
+    @Override
+    public Map<String, Object> getUnPassTemplateParams(TemplateParam templateParam) {
+        return getPassTemplateParams(templateParam);
+    }
+
+    @Override
+    public List<Object> passMapToList(Map<String, Object> map) {
+        Object keyPath = map.get(KEY_PATH);
+        Object include = map.get(INCLUDE);
+        List<Object> objects = new ArrayList<>();
+        objects.add(include);
+        objects.add(keyPath);
+        return objects;
+    }
+
+    @Override
+    public List<Object> unpassMapToList(Map<String, Object> map) {
+        return passMapToList(map);
+    }
+
+
+}
