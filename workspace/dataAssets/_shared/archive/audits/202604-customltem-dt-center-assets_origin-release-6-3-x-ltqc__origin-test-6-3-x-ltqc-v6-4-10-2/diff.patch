+    private RuleDistributionVO buildRuleDistributionVO(RuleTaskType ruleTaskType, Long count, Long usageCount, long totalCount) {
+        RuleDistributionVO vo = new RuleDistributionVO();
+        vo.setRuleType(ruleTaskType.getDesc());
+        vo.setRuleTaskType(ruleTaskType.getType());
+        vo.setRuleCount(count.intValue());
+        if (totalCount > 0) {
+            vo.setPercentage(BigDecimal.valueOf(count)
+                    .divide(BigDecimal.valueOf(totalCount), 4, RoundingMode.HALF_UP)
+                    .multiply(BigDecimal.valueOf(100))
+                    .setScale(2, RoundingMode.HALF_UP));
+            vo.setUsageRate(count > 0
+                    ? BigDecimal.valueOf(usageCount)
+                    .divide(BigDecimal.valueOf(count), 4, RoundingMode.HALF_UP)
+                    .multiply(BigDecimal.valueOf(100))
+                    .setScale(2, RoundingMode.HALF_UP)
+                    : BigDecimal.ZERO);
+        } else {
+            vo.setPercentage(BigDecimal.ZERO);
+            vo.setUsageRate(BigDecimal.ZERO);
+        }
+        return vo;
+    }
