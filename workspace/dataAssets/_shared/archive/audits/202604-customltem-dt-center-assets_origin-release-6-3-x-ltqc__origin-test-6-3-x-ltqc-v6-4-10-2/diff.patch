+    /**
+     * 收集目标 ID 及其所有子孙 ID（逻辑抽离，降低主方法复杂度）
+     */
+    private Set<Long> collectAllIdsToDelete(Collection<Long> targetIds, List<JsonValidationConfig> allEntities) {
+        Set<Long> allIdsToDelete = new HashSet<>(targetIds);
+
+        // 复用之前的子孙查找方法，将每个传入的 ID 作为起点向下找
+        for (Long id : targetIds) {
+            Set<Long> descendantIds = findAllDescendantIds(id, allEntities);
+            allIdsToDelete.addAll(descendantIds);
+        }
+
+        return allIdsToDelete;
+    }
+
+    /**
+     * 查找指定节点在给定数据源中的所有子孙节点 ID（不包含当前节点本身）
+     * 限定最大深度为 5 层，采用非递归的广度优先遍历，性能极佳。
+     *
+     * @param startId      起始节点 ID
+     * @param allEntities  全量数据列表（避免多次查库）
+     * @return 包含所有子孙节点 ID 的集合 (无重复)
+     */
+    private Set<Long> findAllDescendantIds(Long startId, List<JsonValidationConfig> allEntities) {
+        if (startId == null || allEntities == null || allEntities.isEmpty()) {
+            return Collections.emptySet();
+        }
+
+        // 1. 预构建映射：父ID -> 子ID列表 (单层流操作，零嵌套，SonarQube 友好)
+        Map<Long, List<Long>> parentToChildrenMap = allEntities.stream()
+                .filter(e -> e.getParentId() != null && e.getParentId() != 0)
+                .collect(Collectors.groupingBy(
+                        JsonValidationConfig::getParentId,
+                        Collectors.mapping(JsonValidationConfig::getId, Collectors.toList())
+                ));
+
+        Set<Long> descendantIds = new HashSet<>();
+        Queue<Long> queue = new LinkedList<>();
+        queue.add(startId);
+
+        // 2. 逐层向下查找（最多 5 层）
+        int layer = 0;
+        while (!queue.isEmpty() && layer < 5) {
+            int size = queue.size(); // 获取当前层级的节点数量
+
+            for (int i = 0; i < size; i++) {
+                Long currentParentId = queue.poll();
+
+                // 从 Map 中直接获取子节点列表，时间复杂度 O(1)
+                List<Long> children = parentToChildrenMap.getOrDefault(currentParentId, Collections.emptyList());
+
+                for (Long childId : children) {
+                    // Set.add() 返回 true 表示是新发现的节点，避免死循环和重复计算
+                    if (descendantIds.add(childId)) {
+                        queue.add(childId); // 只有新节点才加入下一层的探索队列
+                    }
+                }
+            }
+            layer++;
+        }
+
+        return descendantIds;
+    }
