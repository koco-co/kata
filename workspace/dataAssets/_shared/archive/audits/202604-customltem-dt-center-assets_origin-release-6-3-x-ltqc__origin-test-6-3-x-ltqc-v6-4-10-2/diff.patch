+ */
+@Component("enumValue47")
+public class FieldValueCalculationComparisonHandler extends AbstractTemplateHandler{
+    // 计算结果对比
+    private static final int COMPARISON_OF_CALCULATION_RESULTS = 1;
+
+    @Override
+    public Map<String, Object> getPassTemplateParams(TemplateParam templateParam) {
+        return getUnPassTemplateParams(templateParam);
+    }
+
+    @Override
+    public Map<String, Object> getUnPassTemplateParams(TemplateParam templateParam) {
+        String ruleExpansion = templateParam.getRuleExpansion();
+        FieldValueCalculationComparisonConfig config = JSONObject.parseObject(ruleExpansion, FieldValueCalculationComparisonConfig.class);
+        Map<String, Object> templateParams = new HashMap<>();
+        String result = buildConditionSql(config);
+        templateParams.put("checkData", result);
+        return templateParams;
+    }
+
+    @Override
+    public List<Object> passMapToList(Map<String, Object> map) {
+        return unpassMapToList(map);
+    }
+
+    @Override
+    public List<Object> unpassMapToList(Map<String, Object> map) {
+        List<Object> list = Lists.newLinkedList();
+        list.add(map.getOrDefault("checkData", "--"));
+        return list;
+    }
+
+    private String buildConditionSql(FieldValueCalculationComparisonConfig config) {
+        if(config.getVerifyMethod().equals(COMPARISON_OF_CALCULATION_RESULTS)){
+            return config.getColumnNameStr() + config.getLogic() + config.getLeftComputerLogic();
+        }else{
+            return config.getLeftComputerLogic() + config.getRange().getFirstOperator() + config.getRange().getFirstThreshold()
+                    +' '+ config.getRange().getCondition() +' '
+                    + config.getLeftComputerLogic() + config.getRange().getSecondOperator() + config.getRange().getSecondThreshold();
+        }
+    }
+}
