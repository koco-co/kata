+package com.dtstack.assets.mapper.valid;
+
+import com.dtstack.assets.model.valid.vo.MonitorErrorTopVO;
+import com.dtstack.assets.model.valid.vo.MonitorRecentErrorVO;
+import com.dtstack.assets.model.valid.vo.MonitorTableOptionVO;
+import org.apache.ibatis.annotations.Mapper;
+import org.apache.ibatis.annotations.Param;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+
+@Mapper
+public interface MonitorOverviewDao {
+
+    /**
+     * 统计规则集、规则、监控任务、校验通过/失败数量
+     */
+    Long countDefaultRule(@Param("projectId") Long projectId, @Param("tenantId") Long tenantId);
+
+    Long countCustomRule(@Param("projectId") Long projectId, @Param("tenantId") Long tenantId);
+
+    Long countRuleSet(@Param("projectId") Long projectId, @Param("tenantId") Long tenantId);
+
+    Long countMonitor(@Param("projectId") Long projectId, @Param("tenantId") Long tenantId);
+
+    Long countPass(@Param("projectId") Long projectId,
+                   @Param("tenantId") Long tenantId,
+                   @Param("passStatus") Integer passStatus);
+
+    Long countError(@Param("projectId") Long projectId,
+                    @Param("tenantId") Long tenantId,
+                    @Param("errorStatus") List<Integer> errorStatus);
+
+    /**
+     * 校验异常Top10
+     */
+    List<MonitorErrorTopVO> queryErrorTopRecord(@Param("projectId") Long projectId,
+                                                @Param("tenantId") Long tenantId,
+                                                @Param("errorStatus") List<Integer> errorStatus);
+
+    /**
+     * 近期校验异常结果
+     */
+    List<MonitorRecentErrorVO> queryRecentError(@Param("projectId") Long projectId,
+                                                @Param("tenantId") Long tenantId,
+                                                @Param("errorStatus") List<Integer> errorStatus);
+    /**
+     * 获取配置规则任务的表列表
+     */
+    List<MonitorTableOptionVO> queryTableOptions(@Param("projectId") Long projectId, @Param("tenantId") Long tenantId);
+
+    /**
+     * 7日内异常结果分析
+     */
+    List<LinkedHashMap<String, Object>> queryWeeklyResult(@Param("projectId") Long projectId,
+                                                          @Param("tenantId") Long tenantId,
+                                                          @Param("tableId") Long tableId,
+                                                          @Param("passStatus") Integer passStatus,
+                                                          @Param("unPassStatus") Integer unPassStatus);
+    /**
+     * 按类型获取内置规则数量
+     */
+    List<LinkedHashMap<String, Object>> countDefaultRuleByType(@Param("projectId") Long projectId, @Param("tenantId") Long tenantId);
+
+    /**
+     * 按类型获取自定义规则数量
+     */
+    List<LinkedHashMap<String, Object>> countCustomRuleByType(@Param("projectId") Long projectId, @Param("tenantId") Long tenantId);
+
+    /**
+     * 按类型获取已配置规则数量
+     */
+    List<LinkedHashMap<String, Object>> countRuleCategoriesByType(@Param("projectId") Long projectId, @Param("tenantId") Long tenantId);
+}
