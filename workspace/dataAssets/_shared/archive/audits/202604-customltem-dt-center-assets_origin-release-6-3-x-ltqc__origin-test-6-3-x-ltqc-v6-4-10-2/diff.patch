+    /**
+     * 解析当前全路径的父层级路径
+     * @param fullPath
+     * @param removeKey
+     * @return
+     */
+    private String fullPathToParentPath(String fullPath, String removeKey) {
+        if (fullPath == null || removeKey == null || fullPath.isEmpty() || removeKey.isEmpty()) {
+            return fullPath;
+        }
+        String target = "['" + removeKey + "']";
+        if (fullPath.endsWith(target)) {
+            return fullPath.substring(0, fullPath.length() - target.length());
+        }
+        return fullPath;
+    }
