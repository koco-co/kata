+        FROM assets_dq_monitor m
+        WHERE project_id = #{projectId}
+          AND tenant_id  = #{tenantId}
+          AND is_deleted = 0
+          AND task_type  = 0
+    </select>
+
+    <select id="countPass" resultType="java.lang.Long">
+        SELECT COUNT(1)
+        FROM assets_dq_monitor_record mr
+                 INNER JOIN assets_dq_monitor m ON mr.monitor_id = m.id
+                 INNER JOIN (
+            SELECT monitor_id, MAX(id) AS max_id
+            FROM assets_dq_monitor_record
+            WHERE is_deleted = 0
+              AND status = #{passStatus}
+            GROUP BY monitor_id
+        ) latest_id ON mr.id = latest_id.max_id
+        WHERE m.project_id  = #{projectId}
+          AND m.tenant_id   = #{tenantId}
+          AND m.is_deleted  = 0
+          AND mr.is_deleted = 0
+          AND mr.status     = #{passStatus}
+    </select>
+
+    <select id="countError" resultType="java.lang.Long">
+        SELECT COUNT(1)
+        FROM assets_dq_monitor_record mr
+        INNER JOIN assets_dq_monitor m ON mr.monitor_id = m.id
+        INNER JOIN (
+        SELECT monitor_id, MAX(id) AS max_id
+        FROM assets_dq_monitor_record
+        WHERE is_deleted = 0
+        AND status IN
+        <foreach collection="errorStatus" item="s" open="(" separator="," close=")">
+            #{s}
+        </foreach>
+        GROUP BY monitor_id
+        ) latest_id ON mr.id = latest_id.max_id
+        WHERE m.project_id  = #{projectId}
+        AND m.tenant_id   = #{tenantId}
+        AND m.is_deleted  = 0
+        AND mr.is_deleted = 0
+        AND mr.status IN
+        <foreach collection="errorStatus" item="s" open="(" separator="," close=")">
+            #{s}
+        </foreach>
