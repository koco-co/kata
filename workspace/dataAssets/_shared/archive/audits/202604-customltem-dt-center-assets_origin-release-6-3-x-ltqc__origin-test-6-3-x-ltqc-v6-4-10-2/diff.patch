+    private <T> void fillSourceName(List<T> list,
+                                    Function<T, Long> dataSourceIdGetter,
+                                    BiConsumer<T, String> sourceNameSetter) {
+        if (CollectionUtils.isEmpty(list)) {
+            return;
+        }
+        List<Long> dataSourceIds = list.stream()
+                .map(dataSourceIdGetter)
+                .filter(Objects::nonNull)
+                .distinct()
+                .collect(Collectors.toList());
+        List<DataSourceDTO> dataSourceList = dataSourceThirdService.listDataSourceByIds(dataSourceIds);
+        Map<Long, DataSourceDTO> dataSourceMap = dataSourceList.stream()
+                .collect(Collectors.toMap(DataSourceDTO::getId, ds -> ds));
+        for (T vo : list) {
+            DataSourceDTO ds = dataSourceMap.get(dataSourceIdGetter.apply(vo));
+            if (ds != null) {
+                sourceNameSetter.accept(vo, ds.getDataSourceName());
+            }
+        }
+    }
