+    public void updateSon(JsonValidationConfig jsonValidationConfig, JsonValidationConfig newJsonValidationConfig,
+                          boolean isFirstLevel, boolean dataSourceTypeChanged, boolean jsonKeyChanged) {
+        List<JsonValidationConfig> jsonValidationConfigs = new ArrayList<>();
+        jsonValidationConfigs.add(jsonValidationConfig);
+        List<Long> parentIds = new ArrayList<>();
+        parentIds.add(jsonValidationConfig.getId());
+
+        List<JsonValidationConfig> all = selectListById(jsonValidationConfigs, parentIds);
+        if (all == null || all.isEmpty()) {
+            return;
+        }
+
+        Map<Long, List<JsonValidationConfig>> groupedByParent = all.stream()
+                .collect(Collectors.groupingBy(
+                        config -> config.getParentId() != null ? config.getParentId() : 0L
+                ));
+
+        // 父层级且修改了dataSourceType,子层级页要跟着变
+        if (isFirstLevel && dataSourceTypeChanged) {
+            for (JsonValidationConfig validationConfig : all) {
+                validationConfig.setDataSourceType(newJsonValidationConfig.getDataSourceType());
+            }
+            self.updateBatchById(all);
+        }
+        //父层级的jsonKey变化，子层级的全路径需要有变化
+        if (jsonKeyChanged) {
+            jsonValidationConfig.setJsonKey(newJsonValidationConfig.getJsonKey());
+            String parentFullPath;
+            if(isFirstLevel){
+                parentFullPath = "['" + newJsonValidationConfig.getJsonKey() + "']";
