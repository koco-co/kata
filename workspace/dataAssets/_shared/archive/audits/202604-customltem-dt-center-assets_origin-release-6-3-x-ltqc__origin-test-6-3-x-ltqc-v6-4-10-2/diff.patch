+    private static String buildRuleFilterAndTableReplaceAlias(ReasonableMultiTableColumnValueFunctionConfig config,Map<String,String> tableAliasMap){
+        String ruleFilter = buildRuleFilter(config,true);
+        ruleFilter =  tableNameReplaceAlias(ruleFilter,tableAliasMap);
+        return ruleFilter;
