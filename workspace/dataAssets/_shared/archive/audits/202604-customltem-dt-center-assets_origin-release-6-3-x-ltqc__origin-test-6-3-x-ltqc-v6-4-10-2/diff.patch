+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Author: suxia
+ * Date: 2026/3/31 11:59
+ * Version: v1.0.0
+ * Description: 合理性-多表字段值对比校验
+ **/
+@Data
+@EqualsAndHashCode(callSuper = true)
+public class ReasonableMultiTableColumnValueFunctionConfig extends BaseFunctionConfig {
+
+    private final static List<String> LOGIC_CHAR = Arrays.asList("+","-","*","/","(",")");
+
+    /**
+     * 关联主键
+     */
+    private List<String> relationKeys;
+
+    /**
+     * 关联表
+     */
+    private List<ReasonableMultiTableFunctionRelationTableDTO> relationTables;
+
+    /**
+     * 对比方法。1-计算结果对比、2-计算结果值判断
+     */
+    private Integer verifyMethod;
+
+    /**
+     * 配置左边计算逻辑
+     */
+    private String leftComputerLogic;
+
+    /**
+     * 当verifyMethod=1时 计算结果对比
+     * 配置右边计算逻辑
+     */
+    private String rightComputerLogic;
+
+    /**
+     * 当verifyMethod=1时 计算结果对比
+     * 支持选择>/</=/!=/>=/<=
+     */
+    private String logic;
+
+    /**
+     * 当verifyMethod=2时 计算结果值判断
+     */
+    private Range range;
+
+    private String originalFilter;
+
+    @Override
+    public List<ColumnMeta> getHighlightColumns(MonitorRule rule, String... originTableName){
+
+
+        Map<String,ColumnMeta> highlightColumnMap = new HashMap<>();
+
+        for (String column:getRelationKeys()){
+            ColumnMeta columnMeta = new ColumnMeta();
+            columnMeta.setColumnName(column);
+            columnMeta.setTableName(originTableName[0]);
+            String key = String.format("%s.%s",columnMeta.getTableName(),column);
+            highlightColumnMap.put(key,columnMeta);
+        }
+
+        for (ReasonableMultiTableFunctionRelationTableDTO relationTableDTO:relationTables){
+            for (String column:relationTableDTO.getRelationKeys()){
+                ColumnMeta columnMeta = new ColumnMeta();
+                columnMeta.setColumnName(column);
+                columnMeta.setTableName(relationTableDTO.getTableName());
+                String key = String.format("%s.%s",columnMeta.getTableName(),column);
+                highlightColumnMap.put(key,columnMeta);
+            }
+        }
+
+        Map<String,ColumnMeta> computerLogicHighlightColumnMap = extractHighlightColumnsComputerLogic(originTableName[0]);
+        if (!computerLogicHighlightColumnMap.isEmpty()){
+            highlightColumnMap.putAll(computerLogicHighlightColumnMap);
+        }
+
+        return new ArrayList<>(highlightColumnMap.values());
+    }
+    
+    private Map<String,ColumnMeta> extractHighlightColumnsComputerLogic(String originTableName){
+
+        List<String> tableNames = new ArrayList<>();
+        tableNames.add(originTableName);
+
+        if(Langs.isNotEmpty(relationTables)){
+            relationTables.forEach(rt->tableNames.add(rt.getTableName()));
+        }
+        Map<String,ColumnMeta> highlightColumnMap = new HashMap<>();
+
+        if(Langs.isNotBlank(leftComputerLogic)){
+            Map<String,ColumnMeta> leftHighlightColumnMap = extractHighlightColumnsComputerLogic(leftComputerLogic,tableNames);
+            if (!leftHighlightColumnMap.isEmpty()){
+                highlightColumnMap.putAll(leftHighlightColumnMap);
+            }
+        }
+
+        if(Langs.isNotBlank(rightComputerLogic)){
+            Map<String,ColumnMeta> rightHighlightColumnMap = extractHighlightColumnsComputerLogic(rightComputerLogic,tableNames);
+            if (!rightHighlightColumnMap.isEmpty()){
+                highlightColumnMap.putAll(rightHighlightColumnMap);
+            }
+        }
+
+        return highlightColumnMap;
+    }
+
+    private Map<String,ColumnMeta> extractHighlightColumnsComputerLogic(String computerLogic, List<String> tableNames){
+
+        String finalComputerLogic = computerLogic.replace(" ","");
+        for (String logic:LOGIC_CHAR){
+            if(Langs.isNotBlank(finalComputerLogic)){
+                finalComputerLogic = finalComputerLogic.replace(logic," ");
+            }
+        }
+
+        Map<String,ColumnMeta> highlightColumnMap = new HashMap<>();
+
+        if(Langs.isNotBlank(finalComputerLogic)){
+            String [] nodes = finalComputerLogic.split(" ");
+            for (String node : nodes) {
+                for (String tableName : tableNames) {
+                    String tableNamePrefix = tableName + ".";
+                    if (node.contains(tableNamePrefix)){
+                        ColumnMeta columnMeta = new ColumnMeta();
+                        String [] columnNode  = node.split("\\.");
+                        columnMeta.setColumnName(columnNode[1]);
+                        columnMeta.setTableName(tableName);
+                        highlightColumnMap.put(node,columnMeta);
+                    }
+                }
+            }
+        }
+
+        return highlightColumnMap;
+    }
+}
