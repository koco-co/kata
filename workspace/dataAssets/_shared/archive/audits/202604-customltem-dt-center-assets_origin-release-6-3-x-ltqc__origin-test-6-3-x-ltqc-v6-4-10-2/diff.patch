+
+    public static String buildRuleFilter(ReasonableMultiTableColumnValueFunctionConfig config,Boolean logicNegate){
+        Objects.requireNonNull(config, "配置不能为空");
+        Objects.requireNonNull(config.getVerifyMethod(), "合理性校验-多表字段值对比的对比方法参数不能为空");
+
+        String ruleFilter;
+        if (config.getVerifyMethod() == 1){
+            String logic = logicNegate ? MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(config.getLogic()) : config.getLogic();
+            ruleFilter = String.format(RANGE_FILTER_TEMPLATE,config.getLeftComputerLogic(),logic,config.getRightComputerLogic());
+        }else {
+            ruleFilter = buildRangeFilter(config.getLeftComputerLogic(), config.getRange(),logicNegate);
+        }
+
+        return ruleFilter;
+    }
+
+    private String buildVerifyTablePartitionFilter(ISqlOperator iSqlOperator, Integer datasourceType, List<ReasonableMultiTableFunctionRelationTableDTO> relationTables, Map<String,String> tableAliasMap){
+        List<String> verifyTablePartition = new ArrayList<>();
+        for (ReasonableMultiTableFunctionRelationTableDTO relationTableDTO: relationTables){
+            if (Langs.isBlank(relationTableDTO.getPartition())){
+                continue;
+            }
+            String partitionCondition = iSqlOperator.convertPartToFilterSql(relationTableDTO.getPartition(),datasourceType, Collections.emptyList());
+            verifyTablePartition.add(partitionCondition);
+        }
+
+        if (Langs.isEmpty(verifyTablePartition)){
+            return "";
+        }
+
+        String verifyTablePartitionCondition = String.join(" and ",verifyTablePartition);
+
+        verifyTablePartitionCondition =  tableNameReplaceAlias(verifyTablePartitionCondition,tableAliasMap);
+
+        return String.format(" and ( %s ) ",verifyTablePartitionCondition);
+    }
+
+    private static String buildRangeFilter(String leftComputerLogic,Range range,Boolean logicNegate){
+
+        String operator = logicNegate ? MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(range.getFirstOperator()) : range.getFirstOperator();
+
+        String firstCondition = String.format(RANGE_FILTER_TEMPLATE,leftComputerLogic,operator,range.getFirstThreshold());
+
+        String secondCondition = "";
+        String rangCondition = ""; //and 转换成or 、or 转换成and
+        if (Langs.isNotBlank(range.getSecondOperator()) &&  Langs.isNotBlank(range.getSecondThreshold())){
+            rangCondition = logicNegate ? MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(range.getCondition()) : range.getCondition();
+            operator = logicNegate ? MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(range.getSecondOperator()) : range.getSecondOperator();
+            secondCondition = String.format(RANGE_FILTER_TEMPLATE,leftComputerLogic,operator,range.getSecondThreshold());
+        }
+
+        return Langs.isBlank(secondCondition) ? firstCondition : String.format(RANGE_FILTER_TEMPLATE,firstCondition,rangCondition,secondCondition);
+    }
+
+    private static String tableNameReplaceAlias(String sql,Map<String, String> tableAlias){
+        for (Map.Entry<String, String> entry:tableAlias.entrySet()){
+            sql = sql.replace(entry.getKey(),entry.getValue());
+        }
+        return sql;
+    }
+
+    /**
+     *
+     * @param schema 抽样后的校验主表 db
+     * @param table 抽样后的校验主表名
+     * @param originSchema 抽样前的校验主表 db
