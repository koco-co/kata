+@Component(IFunctionService.FUNCTION_SERVICE_PRE + 47)
+public class FieldValueCalculationComparisonImpl extends BaseFunctionService {
+
+    @Resource
+    private FunctionConfigFactory functionConfigFactory;
+    // 计算结果对比
+    private static final int COMPARISON_OF_CALCULATION_RESULTS = 1;
+    private final static String CONDITION = "${condition}";
+
+    /**
+     * 校验sql
+     *
+     * @param sqlOperator
+     * @param schemaTableUtil
+     * @param functionBO
+     * @return
+     */
+    @Override
+    public String generatorVerifySQL(ISqlOperator sqlOperator, SchemaTableUtil schemaTableUtil, FunctionBO functionBO) {
+
+        String verifySQL = super.generatorVerifySQL(sqlOperator, schemaTableUtil, functionBO);
+
+        FieldValueCalculationComparisonConfig config = getConfig(functionBO);
+
+        String conditionSql = buildConditionSql(config);
+
+        return verifySQL.replace(CONDITION,conditionSql);
+    }
+    
+    /**
+     * 获取配置
+     */
+    private FieldValueCalculationComparisonConfig getConfig(FunctionBO functionBO) {
+        return (FieldValueCalculationComparisonConfig) functionConfigFactory.generateFunctionConfig(47L, functionBO.getExpansion());
+    }
+
+    /**
+     * 脏数据sql
+     *
+     * @param sqlOperator
+     * @param schemaTableUtil
+     * @param functionBO
+     * @return
+     */
+    @Override
+    public String generatorDirtySQL(ISqlOperator sqlOperator, SchemaTableUtil schemaTableUtil, FunctionBO functionBO) {
+
+        String selectColumns = functionBO.getColumnMetas().stream().map(ColumnMetaDTO::getKey).collect(Collectors.joining(","));
+
+        String dirtySQL = super.generatorDirtySQL(sqlOperator, schemaTableUtil, functionBO);
+        
+        FieldValueCalculationComparisonConfig config = getConfig(functionBO);
+        
+        String conditionSql = buildConditionSql(config);
+        
+        return dirtySQL.replace(CONDITION,conditionSql);
+    }
+
+    private String buildConditionSql(FieldValueCalculationComparisonConfig config) {
+        if(config.getVerifyMethod().equals(COMPARISON_OF_CALCULATION_RESULTS)){
+            return config.getColumnNameStr() + MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(config.getLogic()) + config.getLeftComputerLogic();
+        }else{
+            return '(' + config.getLeftComputerLogic() + MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(config.getRange().getFirstOperator()) + config.getRange().getFirstThreshold()
+                    + ' '+ MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(config.getRange().getCondition()) + ' '
+                    + config.getLeftComputerLogic() + MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(config.getRange().getSecondOperator()) + config.getRange().getSecondThreshold()+')';
+        }
+    }
+    
+    /**
+     * 校验规则是否通过
+     *
+     * @param checkRulePass
+     * @return
+     */
+    @Override
+    public Boolean checkRulePass(CheckRulePassDTO checkRulePass) {
+        return Objects.nonNull(checkRulePass.getCountValue()) && checkRulePass.getCountValue() <= 0;
+    }
+
+}
