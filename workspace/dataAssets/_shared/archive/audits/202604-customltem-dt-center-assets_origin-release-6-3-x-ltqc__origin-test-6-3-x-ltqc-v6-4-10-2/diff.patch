+    public String fullPathToPoint(String fullPath){
+        if (fullPath == null || fullPath.isEmpty()) {
+            return fullPath;
+        }
+
+        String result = fullPath.replace("']['", ".")
+                .replace("['", "")
+                .replace("']", "");
+
+        // 如果结果以 "." 开头，去掉开头的点号
+        if (result.startsWith(".")) {
+            result = result.substring(1);
+        }
+
+        return result;
+    }
