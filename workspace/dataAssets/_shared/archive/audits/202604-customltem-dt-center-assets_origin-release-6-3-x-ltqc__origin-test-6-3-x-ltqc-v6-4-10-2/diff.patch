+package com.dtstack.assets.service.schedule.job;
+
+import com.baomidou.mybatisplus.core.toolkit.CollectionUtils;
+import com.dtstack.assets.model.valid.Project;
+import com.dtstack.assets.service.valid.impl.MonitorOverviewService;
+import com.dtstack.assets.service.valid.impl.ProjectService;
+import dt.insight.boot.authz.MetaObjectHolder;
+import net.javacrumbs.shedlock.spring.annotation.SchedulerLock;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.slf4j.MDC;
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+import static com.dtstack.assets.service.schedule.job.ScheduleCallBackStatusJob.JOB_EXPANSION_KEY;
+
+@Component
+public class MonitorRuleSetCountRefreshJob {
+
+    private static final Logger log = LoggerFactory.getLogger("job");
+
+    private final ProjectService projectService;
+
+    private final MonitorOverviewService monitorOverviewService;
+
+    public MonitorRuleSetCountRefreshJob(ProjectService projectService, MonitorOverviewService monitorOverviewService) {
+        this.projectService = projectService;
+        this.monitorOverviewService = monitorOverviewService;
+    }
+
+    @Scheduled(cron = "${MonitorDashboardRefreshJob.cron:0 0 * * * ?}")
+    @SchedulerLock(name = "MonitorDashboardRefreshJob", lockAtMostFor = "PT30M")
+    protected void run() {
+        MDC.put(JOB_EXPANSION_KEY, MonitorRuleSetCountRefreshJob.class.getName());
+        log.info("MonitorDashboardRefreshJob process start...");
+        try {
+            List<Project> allProjects = projectService.getAllProject();
+            if (CollectionUtils.isEmpty(allProjects)) {
+                return;
+            }
+            Map<Long, List<Project>> tenantProjectMap = allProjects.stream()
+                    .collect(Collectors.groupingBy(Project::getTenantId));
+
+            for (Map.Entry<Long, List<Project>> entry : tenantProjectMap.entrySet()) {
+                Long tenantId = entry.getKey();
+                List<Project> projects = entry.getValue();
+                for (Project project : projects) {
+                    Long projectId = project.getId();
+                    try {
+                        MetaObjectHolder.tenantId(tenantId);
+                        MetaObjectHolder.projectId(projectId);
+
+                        // 主动刷新各看板缓存
+                        monitorOverviewService.refreshCountCache(tenantId, projectId);
+                        monitorOverviewService.refreshErrorTopCache(tenantId,projectId);
+                        monitorOverviewService.refreshRecentErrorCache(tenantId,projectId);
+                        monitorOverviewService.refreshWeeklyResultCache(tenantId,projectId);
+                        monitorOverviewService.refreshRuleDistributionCache(tenantId, projectId);
+                        monitorOverviewService.refreshRuleCategoriesCache(tenantId, projectId);
+
+                    } catch (Exception e) {
+                        log.error("MonitorDashboardRefreshJob refresh error, tenantId={}, projectId={}", tenantId, projectId, e);
+                    }
+                }
+            }
+        } catch (Exception e) {
+            log.error("MonitorDashboardRefreshJob error", e);
+        }
+        log.info("MonitorDashboardRefreshJob process end...");
+        MDC.clear();
+    }
