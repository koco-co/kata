+    private static Map<String,String> getVerifyTableAlias(String schema,String table,String originSchema,String originTable,ReasonableMultiTableColumnValueFunctionConfig functionConfig){
+        Map<String,String> tableAliasMap = new LinkedHashMap<>();
+        tableAliasMap.put(String.format(COMPLETE_TABLE_NAME,schema,table),MAIN_TABLE_ALIAS);
+        tableAliasMap.put(table,MAIN_TABLE_ALIAS);
+
+        tableAliasMap.put(String.format(COMPLETE_TABLE_NAME,originSchema,originTable),MAIN_TABLE_ALIAS);
+        tableAliasMap.put(originTable,MAIN_TABLE_ALIAS);
+
+        List<ReasonableMultiTableFunctionRelationTableDTO> relationTables = functionConfig.getRelationTables();
+        for (int i = 0; i < relationTables.size(); i++) {
+            ReasonableMultiTableFunctionRelationTableDTO relationTableDTO = relationTables.get(i);
+            String tableAlias = VERIFY_TABLE_ALIAS_PREFIX + i;
+            tableAliasMap.put(String.format(COMPLETE_TABLE_NAME,relationTableDTO.getSchemaName(),relationTableDTO.getTableName()),tableAlias);
+            tableAliasMap.put(relationTableDTO.getTableName(),tableAlias);
+        }
+        return tableAliasMap;
+    }
+
+    /**
+     * 生成完整的脏数据结果表名
+     * @param sqlOperator 数据源类型
+     * @param source 数据源
+     * @param catalogName catalog
+     * @param schemaName db
+     * @return 完整脏数据表名 dq_monitor_#{function_job_id}_#{ruleId} 在ISqlOperator.concatSql中使用
+     */
+    public String completeDirtyTableName(ISqlOperator sqlOperator, DataSource source, String catalogName, String schemaName){
+        String jobIdAndVerifyTableHashCode = "#{function_job_id}_#{ruleId}";
+        return sqlOperator.getCompleteDirtyTableName(source, catalogName, schemaName, jobIdAndVerifyTableHashCode);
+    }
+}
