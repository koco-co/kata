+package com.dtstack.assets.model.valid;
+
+import com.baomidou.mybatisplus.annotation.FieldStrategy;
+import com.baomidou.mybatisplus.annotation.TableField;
+import com.baomidou.mybatisplus.annotation.TableName;
+import dt.insight.plat.dao.model.DTTPModel;
+import lombok.Data;
+
+@Data
+@TableName("assets_dq_json_validation_config")
+public class JsonValidationConfig extends DTTPModel {
+
+    /**
+     * 用于校验的key
+     */
+    @TableField("json_key")
+    private String jsonKey;
+
+    /**
+     * 中文名称
+     */
+    @TableField(value = "name",updateStrategy = FieldStrategy.IGNORED)
+    private String name;
+
+    /**
+     * 正则表达式
+     */
+    @TableField(value = "value",updateStrategy = FieldStrategy.IGNORED)
+    private String value;
+
+    /**
+     * 数据源类型
+     */
+    @TableField("data_source_type")
+    private Integer dataSourceType;
+
+
+    /**
+     * 父级id
+     */
+    @TableField("parent_id")
+    private Long parentId;
+
+    /**
+     * 当前所处树层级
+     */
+    @TableField("level")
+    private Integer level;
+
+    /**
+     * 当前节点的全路径，例：
+     * ['key1']['key2-4']['key3']
+     */
+    @TableField("full_path")
+    private String fullPath;
+
+    @TableField("full_path_point")
+    private String fullPathPoint;
+}
