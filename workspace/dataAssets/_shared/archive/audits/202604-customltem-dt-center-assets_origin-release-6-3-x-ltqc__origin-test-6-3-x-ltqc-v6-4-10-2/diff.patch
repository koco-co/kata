+    /**
+     * 提取所需节点 ID
+     */
+    private Set<Long> extractRequiredIds(List<JsonValidationConfig> matchedEntities, List<JsonValidationConfig> allEntities) {
+        // 1. 构建 ID -> ParentId 映射 (用于向上找)
+        Map<Long, Long> idToParentMap = allEntities.stream()
+                .collect(Collectors.toMap(JsonValidationConfig::getId, JsonValidationConfig::getParentId));
+
+        // 2. 构建 ParentId -> Children 映射 (用于向下找)
+        Map<Long, List<Long>> parentToChildrenMap = allEntities.stream()
+                .filter(e -> e.getParentId() != null && e.getParentId() != 0)
+                .collect(Collectors.groupingBy(JsonValidationConfig::getParentId,
+                        Collectors.mapping(JsonValidationConfig::getId, Collectors.toList())));
+
+        // 3. 收集匹配节点的 ID
+        Set<Long> currentLayerIds = matchedEntities.stream()
+                .map(JsonValidationConfig::getId)
+                .collect(Collectors.toCollection(HashSet::new));
+
+        Set<Long> requiredIds = new HashSet<>(currentLayerIds);
+
+        // 4. 向上追溯 (最多5层) - 纯线性扁平流
+        for (int i = 0; i < 5; i++) {
+            Set<Long> parentIds = currentLayerIds.stream()
+                    .map(idToParentMap::get)
+                    .filter(Objects::nonNull)
+                    .filter(id -> id != 0)
+                    .collect(Collectors.toSet());
+            if (parentIds.isEmpty()) break;
+            requiredIds.addAll(parentIds);
+            currentLayerIds = parentIds;
+        }
+
+        // 5. 向下追溯 (最多5层) - 纯线性扁平流
+        currentLayerIds = new HashSet<>(requiredIds); // 重置为所有已知节点作为起点向下找
+        for (int i = 0; i < 5; i++) {
+            List<Long> childIds = currentLayerIds.stream()
+                    .flatMap(id -> parentToChildrenMap.getOrDefault(id, Collections.emptyList()).stream())
+                    .collect(Collectors.toList());
+            if (childIds.isEmpty()) break;
+            requiredIds.addAll(childIds);
+            currentLayerIds = new HashSet<>(childIds);
+        }
+
+        return requiredIds;
+    }
+
+    /**
+     * 组装树形结构
+     */
+    private List<JsonValidationConfigVo> buildTreeFromEntities(List<JsonValidationConfig> allEntities, Set<Long> requiredIds) {
+        Map<Long, JsonValidationConfigVo> voMap = new HashMap<>();
+        List<JsonValidationConfigVo> roots = new ArrayList<>();
+        for (JsonValidationConfig entity : allEntities) {
+            if (!requiredIds.contains(entity.getId())) {
+                continue;
+            }
+            JsonValidationConfigVo vo = JsonValidationConfigVo.build(entity);
+            vo.setHasValue(StringUtils.isNotBlank(vo.getValue()) ? 1 : 0);
+            String createUserName = userService.getUserNameByUserId(entity.getCreateBy());
+            String updateUserName = userService.getUserNameByUserId(entity.getUpdateBy());
+            vo.setCreateBy(createUserName);
+            vo.setUpdateBy(updateUserName);
+            voMap.put(vo.getId(), vo);
+            // 提取根节点判断逻辑，避免内部 if 嵌套
+            boolean isRoot = vo.getParentId() == null || vo.getParentId() == 0;
+            if (isRoot) {
+                roots.add(vo);
+            }
+        }
+        // 挂载子节点（利用提前构建好的 voMap，避免嵌套查找）
+        for (JsonValidationConfigVo vo : voMap.values()) {
+            boolean hasParent = vo.getParentId() != null && vo.getParentId() != 0;
+            if (!hasParent) {
+                continue;
+            }
+            // 提取赋值逻辑
+            Optional.ofNullable(voMap.get(vo.getParentId())).ifPresent(parentVo -> {
+                if (parentVo.getChildren() == null) {
+                    parentVo.setChildren(new ArrayList<>());
+                }
+                parentVo.getChildren().add(vo);
+            });
+        }
+
+        return roots;
+    }
