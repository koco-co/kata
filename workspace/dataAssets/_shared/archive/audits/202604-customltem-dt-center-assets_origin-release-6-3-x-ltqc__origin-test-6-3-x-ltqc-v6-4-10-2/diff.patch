+        //数值范围
+        Range valueRange = valueEnumRangeDTO.getValueRange();
+        //枚举范围
+        EnumRangeDTO enumRange = valueEnumRangeDTO.getEnumRange();
+        if (LTQC_SUPPORT_DATASOURCE_TYPE.contains(sourceType) && !"number".equals(columnTypeStr)) {
+            columnStr = String.format(" CAST(%s as DOUBLE) ", columnStr);
+        }
+        String valueSql = buildValueRangeSql(valueRange, columnStr);
+        String enumSql = buildEnumRangeSql(enumRange, columnStr);
+
+        return String.format("(%s %s %s)", valueSql, MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(valueEnumRangeDTO.getCondition()), enumSql);
+    }
+
+    public String buildValueRangeSql(Range valueRange, String columnStr) {
+        if (Objects.isNull(valueRange)) {
+            return "";
+        }
+
+        StringBuilder valueRangeSql = new StringBuilder().append("(");
+        String operator1 = valueRange.getFirstOperator();
+        String threshold1 = valueRange.getFirstThreshold();
+        valueRangeSql.append(columnStr).append(MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(operator1))
+                .append(QUOTE).append(threshold1).append(QUOTE);
+        if (Objects.nonNull(valueRange.getSecondThreshold()) && Objects.nonNull(valueRange.getSecondOperator())) {
+            String threshold2 = valueRange.getSecondThreshold();
+            String operator2 = valueRange.getSecondOperator();
+            valueRangeSql.append(" ").append(MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(valueRange.getCondition())).append(" ");
+            valueRangeSql.append(columnStr).append(MonitorRuleUtil.OPERATOR_REVERSE_MAP.get(operator2))
+                    .append(QUOTE).append(threshold2).append(QUOTE);
+        }
+        return valueRangeSql.append(")").toString();
+    }
+
+    public String buildEnumRangeSql(EnumRangeDTO enumRange, String columnStr) {
+        if (Objects.isNull(enumRange)) {
+            return "";
+        }
+
+        String[] enumArray = enumRange.getThreshold().split(",");
+        String operator = enumRange.getOperator();
+        StringBuilder enumBuilder = new StringBuilder().append("(");
+        enumBuilder.append(columnStr).append(MonitorUtil.ThresholdFullyConversion(operator)).append("(");
+        String joinedEnums = Joiner.on(QUOTE + COMMA + QUOTE)
+                .skipNulls()
+                .join(Arrays.stream(enumArray)
+                        .map(String::trim)
+                        .filter(s -> !s.isEmpty())
+                        .toArray(String[]::new));
+        enumBuilder.append(QUOTE).append(joinedEnums).append(QUOTE);
+        enumBuilder.append("))");
+        return enumBuilder.toString();
+    }
+
+    @Override
+    public Boolean checkRulePass(CheckRulePassDTO checkRulePass) {
+        return Objects.nonNull(checkRulePass.getCountValue()) && checkRulePass.getCountValue() <= 0;
+    }
+}
