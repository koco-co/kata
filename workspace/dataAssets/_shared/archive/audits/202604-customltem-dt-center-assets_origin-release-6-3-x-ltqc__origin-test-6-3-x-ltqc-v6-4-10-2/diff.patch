+    private void readMainSheet(InputStream inputStream, String sheetName, Integer datasourceType,
+                               Map<String, Long> mainKeyToIdMap, Set<String> validFullPathSet,
+                               List<JsonValidationConfig> dataList, Map<Integer, Map<Integer, String>> errorMap, Integer repeatMode) {
+
+        EasyExcelFactory.read(inputStream, MainSheetExcelDTO.class, new ReadListener<MainSheetExcelDTO>() {
+            @Override
+            public void invoke(MainSheetExcelDTO data, AnalysisContext context) {
+                int rowIndex = context.readRowHolder().getRowIndex();
+                String jsonKey = data.getJsonKey();
+                String name = data.getName();
+                String value = data.getValue();
+
+                // 1. 基础校验
+                Map<Integer, String> basicErrors = checkBasicParam(jsonKey, name, value,0,1,2);
+                if (basicErrors != null) {
+                    errorMap.put(rowIndex, basicErrors);
+                    return;
+                }
+
+                String fullPath = "['" + jsonKey + "']";
+
+                // 2. 主表 Key 重复校验 (在第0列报错)
+                if (mainKeyToIdMap.containsKey(fullPath)) {
+                    Map<Integer, String> rowErr = new HashMap<>();
+                    rowErr.put(0, "注意同一个层级下的key名不可重复");
+                    errorMap.put(rowIndex, rowErr);
+                    return;
+                }
+
+                // 4. 封装正确数据
+                JsonValidationConfig jsonValidationConfig = new JsonValidationConfig();
+                jsonValidationConfig.setJsonKey(jsonKey);
+                jsonValidationConfig.setName(name);
+                jsonValidationConfig.setValue(value);
+                jsonValidationConfig.setDataSourceType(datasourceType);
+                jsonValidationConfig.setLevel(levelTransform(sheetName));
+                jsonValidationConfig.setFullPath(fullPath);
+                jsonValidationConfig.setFullPathPoint(fullPathToPoint(fullPath));
+                jsonValidationConfig.setCreateBy(MetaObjectHolder.uid());
+                jsonValidationConfig.setUpdateBy(MetaObjectHolder.uid());
+                jsonValidationConfig.setProjectId(MetaObjectHolder.projectId());
+
+                mainKeyToIdMap.put(fullPath, null);
+                validFullPathSet.add(fullPath);
+                dataList.add(jsonValidationConfig);
+            }
+
+            @Override
+            public void doAfterAllAnalysed(AnalysisContext context) {
+                if (errorMap.isEmpty() && !dataList.isEmpty()) {
+                    // 1. 批量查询数据库中已存在的记录
+                    List<String> jsonKeys = dataList.stream()
+                            .map(JsonValidationConfig::getJsonKey)
+                            .collect(Collectors.toList());
+
+                    Map<String, JsonValidationConfig> existingMap = self.list(
+                            lambdaQuery().getWrapper().in(JsonValidationConfig::getJsonKey, jsonKeys)
+                    ).stream().collect(Collectors.toMap(JsonValidationConfig::getJsonKey, item -> item));
+
+                    // 2. 分离需要更新、跳过和新增的数据
+                    List<JsonValidationConfig> toInsert = new ArrayList<>();
+                    List<JsonValidationConfig> toUpdate = new ArrayList<>();
+
+                    for (JsonValidationConfig newData : dataList) {
+                        JsonValidationConfig existing = existingMap.get(newData.getJsonKey());
+
+                        if (existing != null) {
+                            // 数据库中存在，根据模式处理
+                            if (repeatMode == 1) {
+                                // 模式1：重复则更新
+                                existing.setName(newData.getName());
+                                existing.setValue(newData.getValue());
+                                existing.setDataSourceType(newData.getDataSourceType());
+                                existing.setLevel(newData.getLevel());
+                                existing.setFullPath(newData.getFullPath());
+                                existing.setFullPathPoint(fullPathToPoint(newData.getFullPath()));
+                                existing.setUpdateBy(MetaObjectHolder.uid());
+                                toUpdate.add(existing);
+
+                                // 更新映射关系
+                                mainKeyToIdMap.put(newData.getFullPath(), existing.getId());
+                            } else if (repeatMode == 0) {
+                                // 重复则跳过,后续的parentId为null代表数据重复
+                                mainKeyToIdMap.put(newData.getFullPath(), existing.getId());
+                            }
+                        } else {
+                            // 数据库中不存在，需要新增
+                            toInsert.add(newData);
+                        }
+                    }
+
+                    // 3. 批量更新
+                    if (!toUpdate.isEmpty()) {
+                        self.updateBatchById(toUpdate);
+                    }
+
+                    // 4. 批量插入
+                    if (!toInsert.isEmpty()) {
+                        self.saveBatch(toInsert);
+
+                        // 5. 更新新增记录的ID映射
+                        for (JsonValidationConfig entity : toInsert) {
+                            if (entity.getId() != null) {
+                                mainKeyToIdMap.put(entity.getFullPath(), entity.getId());
+                            }
+                        }
+                    }
+                }
+            }
+
+        }).sheet(sheetName).headRowNumber(1).doRead();
+    }
