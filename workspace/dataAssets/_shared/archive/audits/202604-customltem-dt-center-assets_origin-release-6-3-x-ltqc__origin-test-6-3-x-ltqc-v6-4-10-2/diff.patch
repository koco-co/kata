+package com.dtstack.assets.service.valid.rule;
+
+import com.alibaba.excel.util.StringUtils;
+import com.alibaba.fastjson.JSONObject;
+import com.dtstack.assets.model.valid.Range;
+import com.dtstack.assets.model.valid.dto.EnumRangeDTO;
+import com.dtstack.assets.model.valid.dto.ValueEnumRangeDTO;
+import com.dtstack.assets.service.valid.function.config.ValueEnumRangeConfig;
+import com.google.common.collect.Lists;
+import org.springframework.stereotype.Component;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * @author tongmeng
+ * @Desc 有效性校验-取值范围&枚举值范围
+ * @Date 2026/4/1
+ */
+
+@Component("enumValue49")
+public class ValueEnumRangeTemplateHandler extends AbstractTemplateHandler {
+
+    private static final String QUOTE = "'";
+
+    private static String CHECK_EXPRESSION_TEMPLATE = "“取值范围%s” %s “枚举值%s”";
+
+    @Override
+    public Map<String, Object> getPassTemplateParams(TemplateParam templateParam) {
+        return buildCheckExpression(templateParam);
+    }
+
+    @Override
+    public Map<String, Object> getUnPassTemplateParams(TemplateParam templateParam) {
+        return getPassTemplateParams(templateParam);
+    }
+
+    public Map<String, Object> buildCheckExpression(TemplateParam templateParam) {
+        Map<String, Object> templateParams = new HashMap<>();
+
+        String ruleExpansion = templateParam.getRuleExpansion();
+        ValueEnumRangeConfig config = JSONObject.parseObject(ruleExpansion, ValueEnumRangeConfig.class);
+
+        ValueEnumRangeDTO valueEnumRangeDTO = config.getValueEnumRangeDTO();
+        Range range = valueEnumRangeDTO.getValueRange();
+        EnumRangeDTO enumRange = valueEnumRangeDTO.getEnumRange();
+
+        StringBuilder rangeExpressionBuilder = new StringBuilder();
+
+        rangeExpressionBuilder.append(range.getFirstOperator()).append(range.getFirstThreshold());
+        if (range.getSecondOperator() != null && range.getSecondThreshold() != null) {
+            rangeExpressionBuilder.append(judgeCondition(range.getCondition())).append(range.getSecondOperator())
+                    .append(range.getSecondThreshold());
+        }
+        String rangeExpression = rangeExpressionBuilder.toString();
+
+        String enumExpression = enumRange.getOperator() + QUOTE + enumRange.getThreshold() + QUOTE;
+
+        String result = String.format(CHECK_EXPRESSION_TEMPLATE, rangeExpression, judgeCondition(valueEnumRangeDTO.getCondition()), enumExpression);
+        templateParams.put("checkData", result);
+        return templateParams;
+    }
+
+    private String judgeCondition(String condition) {
+        if (StringUtils.isBlank(condition)) {
+            return "";
+        }
+        return "and".equalsIgnoreCase(condition.trim()) ? "且" : "或";
+    }
+
+    @Override
+    public List<Object> passMapToList(Map<String, Object> map) {
+        return unpassMapToList(map);
+    }
+
+    @Override
+    public List<Object> unpassMapToList(Map<String, Object> map) {
+        List<Object> list = Lists.newLinkedList();
+        list.add(map.getOrDefault("checkData", "--"));
+        return list;
+    }
+}
