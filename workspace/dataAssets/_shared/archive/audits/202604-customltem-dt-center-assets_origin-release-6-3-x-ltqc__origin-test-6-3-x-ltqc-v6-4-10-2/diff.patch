+    /**
+     * 批量删除节点及其所有子孙节点
+     * @param ids 需要删除的节点 ID 集合
+     * @return 是否全部删除成功
+     */
+    public Boolean deleteBatchByIds(List<Long> ids) {
+        if (ObjectUtil.isEmpty(ids)) {
+            return false;
+        }
+
+        LambdaQueryWrapper<JsonValidationConfig> queryWrapper = new LambdaQueryWrapper<>();
+        queryWrapper.eq(JsonValidationConfig::getProjectId, MetaObjectHolder.projectId());
+        // 查询全量数据
+        List<JsonValidationConfig> allEntities = jsonValidationConfigDao.selectList(queryWrapper);
+
+        // 收集所有需要被删除的 ID
+        Set<Long> allIdsToDelete = collectAllIdsToDelete(ids, allEntities);
+
+        // 执行真正的批量删除
+        if (jsonValidationConfigDao.deleteBatchIds(allIdsToDelete) == allIdsToDelete.size()) {
+            return true;
+        }
+
+        log.error("删除数量[{}]与需删除数量[{}]不符", jsonValidationConfigDao.deleteBatchIds(allIdsToDelete), allIdsToDelete.size());
+        return false;
+    }
