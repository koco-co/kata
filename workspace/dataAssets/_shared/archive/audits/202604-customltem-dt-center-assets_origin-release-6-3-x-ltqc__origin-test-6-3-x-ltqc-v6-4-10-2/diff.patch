+    /**
+     * 树解析为list，导出接口专用
+     * @param jsonValidationConfigVos
+     * @return
+     */
+    public List<JsonValidationConfigVo> parseJsonChild(List<JsonValidationConfigVo> jsonValidationConfigVos) {
+        List<JsonValidationConfigVo> result = new ArrayList<>(jsonValidationConfigVos);
+        for (JsonValidationConfigVo jsonValidationConfigVo : jsonValidationConfigVos) {
+            List<JsonValidationConfigVo> children = jsonValidationConfigVo.getChildren();
+            if (children != null && !children.isEmpty()) {
+                // 1. 递归获取子节点及其下属节点
+                List<JsonValidationConfigVo> flatChildren = parseJsonChild(children);
+                // 2. 将递归结果追加到当前的 result 中
+                result.addAll(flatChildren);
+            }
+        }
+        return result;
+    }
