+package com.dtstack.assets.model.valid.dto;
+
+import lombok.AllArgsConstructor;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+import java.io.Serializable;
+import java.util.List;
+
+/**
+ * 合理性校验-多表字段值对比
+ *
+ * @author ：suxia
+ * date：Created in 15:39 2026/3/31
+ * company: www.dtstack.com
+ */
+@Data
+@NoArgsConstructor
+@AllArgsConstructor
+public class ReasonableMultiTableFunctionRelationTableDTO implements Serializable {
+
+
+    /**
+     * 分区字段及表达
+     */
+    private String partition;
+
+    /**
+     * 分区类型,预留字段-前端交互使用
+     */
+    private Integer tablePartitionType;
+
+    /**
+     * 字段名
+     */
+    private String columnName;
+
+    /**
+     * 字段名
+     */
+    private String columnType;
+
+    /**
+     * 比对 =/>/>=/</<=/!=/in/not in/包含/不包含
+     */
+    private String operator;
+
+    /**
+     * 阈值
+     */
