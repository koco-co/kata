+    private void readSubSheet(InputStream inputStream, String sheetName, Integer datasourceType,
+                              Map<String, Long> mainKeyToIdMap, Set<String> validFullPathSet,
+                              List<JsonValidationConfig> dataList, Map<Integer, Map<Integer, String>> errorMap, int subLevel, Integer repeatMode) {
+
+        Class<?> dtoClass = getDtoClassByLevel(subLevel);
+
+        EasyExcelFactory.read(inputStream, dtoClass, new ReadListener<Object>() {
+            @Override
+            public void invoke(Object dtoData, AnalysisContext context) {
+                int rowIndex = context.readRowHolder().getRowIndex();
+
+                String jsonKey = (String) getFieldValue(dtoData, "jsonKey");
+                String name = (String) getFieldValue(dtoData, "name");
+                String value = (String) getFieldValue(dtoData, "value");
+
+                // 1. 基础校验
+                Map<Integer, String> basicErrors = checkBasicParam(jsonKey, name, value, subLevel, subLevel + 1, subLevel + 2);
+                if (basicErrors != null) {
+                    errorMap.put(rowIndex, basicErrors);
+                    return;
+                }
+
+                // 2. 动态拼接 parentKey
+                StringBuilder parentKey = new StringBuilder();
+                for (int i = 1; i <= subLevel; i++) {
+                    String pkValue = (String) getFieldValue(dtoData, "parentKey" + i);
+                    parentKey.append("['").append(pkValue).append("']");
+                    // 3. 父层级校验
+                    if (!validFullPathSet.contains(parentKey.toString())) {
+                        Map<Integer, String> rowErr = new HashMap<>();
+                        rowErr.put(i-1, "父层级无对应key名");
+                        errorMap.put(rowIndex, rowErr);
+                        return;
+                    }
+                }
+
+                // 4. 当前层级重复校验
+                String currentFullPath = parentKey +"['" + jsonKey + "']";
+                boolean isDuplicate = dataList.stream()
+                        .anyMatch(item -> Objects.equals(item.getFullPath(), currentFullPath));
+                if (isDuplicate) {
+                    Map<Integer, String> rowErr = new HashMap<>();
+                    // subLevel 就代表当前是第几层
+                    rowErr.put(subLevel, "注意同一个层级下的key名不可重复");
+                    errorMap.put(rowIndex, rowErr);
+                    return;
+                }
+
+                // 5. 封装正确数据
+                JsonValidationConfig sub = new JsonValidationConfig();
+                sub.setJsonKey(jsonKey);
+                sub.setName(name);
+                sub.setValue(value);
+                sub.setDataSourceType(datasourceType);
+                sub.setLevel(levelTransform(sheetName));
+                sub.setFullPath(currentFullPath);
+                sub.setFullPathPoint(fullPathToPoint(currentFullPath));
+                sub.setCreateBy(MetaObjectHolder.uid());
+                sub.setUpdateBy(MetaObjectHolder.uid());
+                sub.setProjectId(MetaObjectHolder.projectId());
+
+                Long parentId = mainKeyToIdMap.get(parentKey.toString());
+                if (parentId != null) {
+                    sub.setParentId(parentId);
+                }
+
+                dataList.add(sub);
+            }
+
+            @Override
+            public void doAfterAllAnalysed(AnalysisContext context) {
+                if (errorMap.isEmpty() && !dataList.isEmpty()) {
+
+                    List<JsonValidationConfig> toInsert = new ArrayList<>();
+                    List<JsonValidationConfig> toUpdate = new ArrayList<>();
+
+                    for (JsonValidationConfig jsonValidationConfig : dataList) {
+                        String jsonKey = jsonValidationConfig.getJsonKey();
+                        String parentPath = fullPathToParentPath(jsonValidationConfig.getFullPath(), jsonValidationConfig.getJsonKey());
+                        Long l = mainKeyToIdMap.get(parentPath);
+                        //说明父层级存在
+                        if(ObjectUtils.isNotEmpty(l)){
+                            LambdaQueryWrapper<JsonValidationConfig> wapper = new LambdaQueryWrapper<>();
+                            wapper.eq(JsonValidationConfig::getParentId, l);
+                            wapper.eq(JsonValidationConfig::getJsonKey, jsonKey);
+                            JsonValidationConfig one = self.getOne(wapper);
+                            //说明当前层级重复
+                            if(ObjectUtils.isNotEmpty(one)){
+                                jsonValidationConfig.setId(one.getId());
+                                jsonValidationConfig.setParentId(one.getParentId());
+                                //重复则更新
+                                if(repeatMode == 1){
+                                    toUpdate.add(jsonValidationConfig);
+                                    mainKeyToIdMap.put(jsonValidationConfig.getFullPath(), jsonValidationConfig.getId());
+                                }else if (repeatMode == 0){
+                                    //重复则跳过
+                                    mainKeyToIdMap.put(jsonValidationConfig.getFullPath(), jsonValidationConfig.getId());
+                                }
+                            }else {
+                                //当前层级不重复，正常逻辑直接插入
+                                toInsert.add(jsonValidationConfig);
+                            }
+                        }
+                        //无论是否重复都要记录全路径
+                        validFullPathSet.add(jsonValidationConfig.getFullPath());
+                    }
+
+                    if(!toInsert.isEmpty()) {
+                        self.saveBatch(toInsert);
+                        // 5. 更新新增记录的ID映射
+                        for (JsonValidationConfig entity : toInsert) {
+                            if (entity.getId() != null) {
+                                mainKeyToIdMap.put(entity.getFullPath(), entity.getId());
+                            }
+                        }
+                    }
+                    self.updateBatchById(toUpdate);
+
+                }
+            }
+
+        }).sheet(sheetName).headRowNumber(1).doRead();
+    }
