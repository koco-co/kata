+@Component(IFunctionService.FUNCTION_SERVICE_PRE + 51L)
+@RequiredArgsConstructor
+public class JsonValidationKeyValueFunctionServiceImpl extends BaseFunctionService {
+
+
+    private final FunctionConfigFactory functionConfigFactory;
+    private final JsonValidationConfigService jsonValidationConfigService;
+
+    private static final String EXCEPTION_MESSAGE = "有效性校验_格式-json格式校验，选择的校验Key不存在";
+    private static final String UDF_NAME = "json_regex_validator";
+    private static final String UDF_CLASS_PATH = "com.dtstack.demo.udf.JsonRegexValidatorUDF";
+
+    public static final String JOB_ID = "_#{jobId}";
+    public static final String UNIQUE_PLACEHOLDER = "${unique}";
+
+    @Override
+    public String generatorVerifySQL(ISqlOperator sqlOperator, SchemaTableUtil schemaTableUtil, FunctionBO functionBO) {
+        String verifySQL = baseGeneratorVerifySQL(sqlOperator, schemaTableUtil, functionBO);
+        return buildVerifySql(verifySQL, functionBO);
+    }
+
+    @Override
+    public String generatorDirtySQL(ISqlOperator sqlOperator, SchemaTableUtil schemaTableUtil, FunctionBO functionBO) {
+        String verifySQL = baseGeneratorDirtySQL(sqlOperator, schemaTableUtil, functionBO);
+        return buildVerifySql(verifySQL, functionBO);
+    }
+
+    @Override
+    public String executorBefore(Integer dataSourceType) {
+        String udfName = UDF_NAME + JOB_ID;
+        if (HIVE_UDF_DATASOURCE.contains(dataSourceType)) {
+            return String.format(HIVE_UDF_TEMPALTE, udfName, udfName, UDF_CLASS_PATH, udfHdfsPath);
+        }
+        return null;
+    }
+
+    @Override
+    public Boolean checkRulePass(CheckRulePassDTO checkRulePass) {
+        return checkRulePass.getCountValue() <= 0;
+    }
+
+    private String buildVerifySql(String verifySQL, FunctionBO functionBO) {
+
+        KeyRangeConfig config = (KeyRangeConfig) functionConfigFactory.generateFunctionConfig(51L, functionBO.getExpansion());
+
+        List<JsonValidationConfigDTO> checkDTOList;
+        if (Objects.equals(config.getIsAll(), 1)) {
+            checkDTOList = jsonValidationConfigService.getAllCheckDTOByDataSourceType(config.getDataSourceType(), MetaObjectHolder.projectId());
+        }else {
+            checkDTOList = jsonValidationConfigService.getCheckDTOByIds(config.getIdList());
+        }
+
+        if (CollectionUtils.isEmpty(checkDTOList)) {
+            throw new BizException(EXCEPTION_MESSAGE);
+        }
+
+        JSONObject jsonObject = new JSONObject();
+        for (JsonValidationConfigDTO configDTO : checkDTOList) {
+            jsonObject.put(configDTO.getFullPath(), configDTO.getValue());
+        }
+        String param = JSON.toJSONString(jsonObject);
+        String escape = "\"" + StringEscapeUtils.escapeJava(param) + "\"";
+        return verifySQL.replace("${value}", escape)
+                .replace(UNIQUE_PLACEHOLDER, JOB_ID);
+    }
+}
