+        name,value,dataSource_type,
+        parent_id,level,full_path,full_path_point
+    </sql>
+
+    <insert id="insertBatch">
+        INSERT INTO assets_dq_json_validation_config (
+        id,
+        json_key,
+        name,
+        value,
+        datasource_type,
+        parent_id,
+        level,
+        create_user_id,
+        modify_user_id,
+        gmt_create,
+        gmt_modified,
+        is_deleted,
+        project_id,
+        tenant_id,
+        full_path
+        ) VALUES
+        <foreach collection="list" item="item" separator=",">
+            (
+            #{item.id},
+            #{item.jsonKey},
+            #{item.name},
+            #{item.value},
+            #{item.datasourceType},
+            #{item.parentId},
+            #{item.level},
+            #{item.createUserId},
+            #{item.modifyUserId},
+            #{item.gmtCreate},
+            #{item.gmtModified},
+            #{item.isDeleted},
+            #{item.projectId},
+            #{item.tenantId},
+            #{item.fullPath}
+            )
+        </foreach>
+    </insert>
+</mapper>
