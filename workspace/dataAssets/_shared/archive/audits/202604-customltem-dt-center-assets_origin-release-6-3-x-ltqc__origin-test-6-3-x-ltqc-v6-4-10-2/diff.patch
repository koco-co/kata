+
+    /**
+     * 基于 jsonKey 模糊查询，返回匹配 key 所在的所有层级数据
+     */
+    public List<JsonValidationConfigVo> queryTreeByJsonKey(String jsonKey, Integer datasourceType) {
+        if (StringUtils.isBlank(jsonKey) || jsonKey.trim().isEmpty()) {
+            return buildTreeStructures();
+        }
+
+        LambdaQueryWrapper<JsonValidationConfig> queryWrapper = new LambdaQueryWrapper<>();
+        if (datasourceType != null) {
