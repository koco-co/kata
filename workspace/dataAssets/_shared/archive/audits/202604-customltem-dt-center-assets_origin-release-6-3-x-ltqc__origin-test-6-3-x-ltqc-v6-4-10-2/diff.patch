+        //查找匹配到的所有节点树并进行去重
+        Set<Long> requiredIds = extractRequiredIds(matchedEntities, allEntities);
+        //构建树型结构
+        return buildTreeFromEntities(allEntities, requiredIds);
+    }
+
+    /**
+     * 分页查询树形结构（按第一层节点统计）
+     * @param jsonKey jsonKey模糊搜索条件
+     * @param datasourceType 数据源类型
+     * @param currentPage 当前页码
+     * @param pageSize 每页条数
+     * @return 分页结果，包含第一层节点及其所有子节点
+     */
+    public PageResult<List<JsonValidationConfigVo>> queryTreePageByJsonKey(String jsonKey, Integer datasourceType,
+                                                                           Integer currentPage, Integer pageSize) {
+        //1.观察是否有模糊查询条件，无模糊查询则直接按照更新时间分页查询所有的父节点
+        List<JsonValidationConfig> topParent;
+        LambdaQueryWrapper<JsonValidationConfig> queryWrapper = new LambdaQueryWrapper<>();
+        queryWrapper.eq(JsonValidationConfig::getProjectId, MetaObjectHolder.projectId());
+        if(ObjectUtils.isNotEmpty(datasourceType)) {
+            queryWrapper.eq(JsonValidationConfig::getDataSourceType, datasourceType);
+        }
+        //有模糊查询则需要查询子层级，没有则只查询父层级
+        boolean hasFuzzyQuery = StringUtils.isNotBlank(jsonKey);
+        if(hasFuzzyQuery){
+            queryWrapper.like(JsonValidationConfig::getJsonKey, jsonKey);
+        }else {
+            queryWrapper.eq(JsonValidationConfig::getParentId, 0);
+        }
+        topParent = jsonValidationConfigDao.selectList(queryWrapper);
+        //将模糊查询的子层级转化为顶层父层级
+        if(hasFuzzyQuery){
+            topParent = selectTopParent(topParent);
+        }
+        //父层级按照时间排序
+        topParent.sort((o1, o2) -> {
+            if (o1.getUpdateAt() == null && o2.getUpdateAt() == null) {
+                return 0;
+            }
+            if (o1.getUpdateAt() == null) {
+                return 1;
+            }
+            if (o2.getUpdateAt() == null) {
+                return -1;
+            }
+            return o2.getUpdateAt().compareTo(o1.getUpdateAt());
+        });
+
+        int total = topParent.size();
+        int totalPages = total > 0 ? (total + pageSize - 1) / pageSize : 0;
+        if (total == 0) {
+            return new PageResult<>(currentPage, pageSize, 0, totalPages, new ArrayList<>());
+        }
+        int fromIndex = (currentPage - 1) * pageSize;
+        int toIndex = Math.min(fromIndex + pageSize, total);
+        if (fromIndex >= total) {
+            return new PageResult<>(currentPage, pageSize, total, totalPages, new ArrayList<>());
+        }
+        List<JsonValidationConfig> pagedList = topParent.subList(fromIndex, toIndex);
+        //根据所有参数构建树型结构
+        List<JsonValidationConfigVo> jsonValidationConfigVos = buildTreeFromParent(pagedList);
+        sortTree(jsonValidationConfigVos);
+
+        return new PageResult<>(currentPage, pageSize, total, totalPages, jsonValidationConfigVos);
+    }
+
+    /**
+     * 根据顶层父节点构建树型结构
+     * @param topParent 顶层父节点列表（parentId=0的节点）
+     * @return 树形结构的VO列表
+     */
+    public List<JsonValidationConfigVo> buildTreeFromParent(List<JsonValidationConfig> topParent) {
+        if (CollUtil.isEmpty(topParent)) {
+            return new ArrayList<>();
+        }
+
+        // 1. 收集所有顶层父节点的ID
+        List<Long> parentIds = topParent.stream()
+                .map(JsonValidationConfig::getId)
+                .collect(Collectors.toList());
+
+        // 2. 递归查询所有节点
+        List<JsonValidationConfig> allNodes = selectListById(new ArrayList<>(topParent), parentIds);
+
+        Set<Long> allIds = allNodes.stream().map(JsonValidationConfig::getId).collect(Collectors.toSet());
+        return buildTreeFromEntities(allNodes, allIds);
+    }
+
+
+    /**
+     * 查询节点列表的所有顶层父节点
+     * @param child
+     * @return
+     */
+    public List<JsonValidationConfig> selectTopParent(List<JsonValidationConfig> child) {
+        List<JsonValidationConfig> topParent = new ArrayList<>();
+        Set<Long> processedIds = new HashSet<>();
+
+        for (JsonValidationConfig jsonValidationConfig : child) {
+            //父节点直接加入到结果集
+            if(jsonValidationConfig.getParentId() == 0){
+                if (!processedIds.contains(jsonValidationConfig.getId())) {
+                    topParent.add(jsonValidationConfig);
+                    processedIds.add(jsonValidationConfig.getId());
+                }
+            }else {
+                //子节点则继续查询
+                JsonValidationConfig parent = findTopParent(jsonValidationConfig.getParentId());
+                if (parent != null && !processedIds.contains(parent.getId())) {
+                    topParent.add(parent);
+                    processedIds.add(parent.getId());
+                }
+            }
+        }
+
+        return topParent;
+    }
+
+    /**
+     * 递归查找顶层父节点
+     * @param parentId 父节点ID
+     * @return 顶层父节点
+     */
+    private JsonValidationConfig findTopParent(Long parentId) {
+        if (parentId == null || parentId == 0) {
+            return null;
+        }
+        JsonValidationConfig parent = jsonValidationConfigDao.selectById(parentId);
+        if (parent.getParentId() == 0) {
+            return parent;
+        }
+        return findTopParent(parent.getParentId());
+    }
+
+
+    /**
+     * 树型结构排序，按照更新时间倒序排序
+     * @param treeList
+     */
+    public void sortTree(List<JsonValidationConfigVo> treeList) {
+        if (CollUtil.isEmpty(treeList)) {
+            return;
+        }
+
+        for (JsonValidationConfigVo node : treeList) {
+            if (CollUtil.isNotEmpty(node.getChildren())) {
+                sortTree(node.getChildren());
+            }
+        }
+
+        treeList.sort((o1, o2) -> {
+            if (o1.getUpdateAt() == null && o2.getUpdateAt() == null) {
+                return 0;
+            }
+            if (o1.getUpdateAt() == null) {
+                return 1;
+            }
+            if (o2.getUpdateAt() == null) {
+                return -1;
+            }
+            return o2.getUpdateAt().compareTo(o1.getUpdateAt());
+        });
+    }
