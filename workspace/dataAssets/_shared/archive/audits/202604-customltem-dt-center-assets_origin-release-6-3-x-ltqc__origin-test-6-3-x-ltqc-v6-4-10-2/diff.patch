+package com.dtstack.assets.service.valid.function.config;
+
+import com.dtstack.assets.model.valid.MonitorRule;
+import com.dtstack.assets.model.valid.Range;
+import lombok.Data;
+import lombok.EqualsAndHashCode;
+
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+
+/**
+ * @author Zero
+ * Date  2026/3/30 11:22
+ * Description: 合理性校验 - 字段值计算对比
+ */
+@Data
+@EqualsAndHashCode(callSuper = true)
+public class FieldValueCalculationComparisonConfig extends BaseFunctionConfig{
+
+    private final static List<String> LOGIC_CHAR = Arrays.asList("+","-","*","/","(",")");
+    // 匹配标识符：字母/下划线开头，后续字母数字下划线
+    private static final Pattern IDENTIFIER = Pattern.compile("[A-Za-z_][A-Za-z0-9_]*");
+
+    /**
+     * 对比方法。1-计算结果对比、2-计算结果值判断
+     */
+    private Integer verifyMethod;
+
+    /**
+     * 配置左边计算逻辑
+     */
+    private String leftComputerLogic;
+
+    /**
+     * 当verifyMethod=1时 计算结果对比
+     * 支持选择>/</=/!=/>=/<=
+     */
+    private String logic;
+
+    /**
+     * 当verifyMethod=2时 计算结果值判断
+     */
+    private Range range;
+
+    @Override
+    public List<ColumnMeta> getHighlightColumns(MonitorRule rule, String... originTableName){
+
+        List<ColumnMeta> highlightColumns = super.getHighlightColumns(rule,originTableName);
+
+        Set<String> computerLogicHighlightColumns = extractColumns(leftComputerLogic);
+        if (!computerLogicHighlightColumns.isEmpty()){
+            List<ColumnMeta> columnMetas = computerLogicHighlightColumns.stream().map(c->{
+                ColumnMeta columnMeta = new ColumnMeta();
+                columnMeta.setTableName(originTableName[0]);
+                columnMeta.setColumnName(c);
+                return columnMeta;
+            }).collect(Collectors.toList());
+            highlightColumns.addAll(columnMetas);
+        }
+
+        return highlightColumns;
+    }
+
+    public static Set<String> extractColumns(String leftComputerLogic) {
+        LinkedHashSet<String> columns = new LinkedHashSet<>();
+        Matcher m = IDENTIFIER.matcher(leftComputerLogic);
+        while (m.find()) {
+            String token = m.group();
+            int end = m.end();
+            // 跳过 token 后面的空白
+            while (end < leftComputerLogic.length() && Character.isWhitespace(leftComputerLogic.charAt(end))) {
+                end++;
+            }
+            // 后面紧跟 '(' 则是函数名，不是列名
+            boolean isFunction = (end < leftComputerLogic.length() && leftComputerLogic.charAt(end) == '(');
+            if (!isFunction) {
+                columns.add(token);
+            }
+        }
+        return columns;
+    }
+}
