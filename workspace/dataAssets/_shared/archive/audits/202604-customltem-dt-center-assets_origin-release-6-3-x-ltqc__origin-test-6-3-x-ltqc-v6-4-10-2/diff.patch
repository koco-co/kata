+package com.dtstack.assets.service.excel;
+
+import org.apache.poi.ss.usermodel.*;
+import org.apache.poi.xssf.usermodel.XSSFWorkbook;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Map;
+
+public class ExcelErrorCommentWriter {
+
+    private ExcelErrorCommentWriter () {}
+
+    /**
+     * 生成带有错误批注的 Excel 文件
+     *
+     * @param originalInputStream 原始上传文件的输入流
+     * @param errorMap            结构：Sheet索引 -> 行号 -> 列号 -> 错误原因
+     * @param outputPath          输出的错误文件绝对路径
+     */
+    public static void writeErrorComments(InputStream originalInputStream,
+                                          Map<Integer, Map<Integer, Map<Integer, String>>> errorMap,
+                                          String outputPath) throws IOException {
+        File outFile = new File(outputPath);
+        if (!outFile.getParentFile().exists()) {
+            outFile.getParentFile().mkdirs();
+        }
+
+        try (Workbook workbook = new XSSFWorkbook(originalInputStream);
+             FileOutputStream fos = new FileOutputStream(outFile)) {
+
+            CreationHelper factory = workbook.getCreationHelper();
+
+            CellStyle redFontStyle = workbook.createCellStyle();
+            Font redFont = workbook.createFont();
+            redFont.setColor(IndexedColors.RED.getIndex());
+            redFontStyle.setFont(redFont);
+
+            for (Map.Entry<Integer, Map<Integer, Map<Integer, String>>> sheetEntry : errorMap.entrySet()) {
+                int sheetIndex = sheetEntry.getKey();
+                Sheet sheet = workbook.getSheetAt(sheetIndex);
+                Drawing<?> drawing = sheet.createDrawingPatriarch();
+
+                for (Map.Entry<Integer, Map<Integer, String>> rowEntry : sheetEntry.getValue().entrySet()) {
+                    int rowNum = rowEntry.getKey();
+                    Row row = sheet.getRow(rowNum);
+                    if (row == null) continue;
+
+                    for (Map.Entry<Integer, String> cellEntry : rowEntry.getValue().entrySet()) {
+                        int colNum = cellEntry.getKey();
+                        String errorMsg = cellEntry.getValue();
+
+                        Cell cell = row.getCell(colNum);
+                        if (cell == null) {
+                            cell = row.createCell(colNum);
+                        }
+
+                        cell.setCellStyle(redFontStyle);
+
+                        ClientAnchor anchor = factory.createClientAnchor();
+                        anchor.setCol1(colNum);
+                        anchor.setRow1(rowNum);
+                        anchor.setCol2(colNum + 3);
+                        anchor.setRow2(rowNum + 4);
+
+                        Comment comment = drawing.createCellComment(anchor);
+                        comment.setString(factory.createRichTextString(errorMsg));
+                        comment.setAuthor("System Validator");
+                        cell.setCellComment(comment);
+                    }
+                }
+            }
+            workbook.write(fos);
+        }
+    }
+}
