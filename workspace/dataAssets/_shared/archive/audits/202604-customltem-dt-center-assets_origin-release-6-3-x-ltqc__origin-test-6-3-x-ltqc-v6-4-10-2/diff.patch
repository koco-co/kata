+        Map<Integer, String> errors = new HashMap<>();
+        if (StringUtils.isEmpty(jsonKey)) {
+            errors.put(keyCol, "必填项未填写");
+        } else if (jsonKey.length() > 255) {
+            errors.put(keyCol, "长度超限");
+        }
+        if (StringUtils.isNotEmpty(name) && name.length() > 255) {
+            errors.put(nameCol, "长度超限");
+        }
+        if (StringUtils.isNotEmpty(value) && value.length() > 255) {
+            errors.put(valueCol, "必填项未填写");
+        }
+        return errors.isEmpty() ? null : errors;
+    }
