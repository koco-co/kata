diff --git a/dao/src/main/resources/dmMysqlMapper/valid/MonitorOverview.xml b/dao/src/main/resources/dmMysqlMapper/valid/MonitorOverview.xml
new file mode 100644
index 000000000..bc5e17724
--- /dev/null
+++ b/dao/src/main/resources/dmMysqlMapper/valid/MonitorOverview.xml
@@ -0,0 +1,244 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
+<mapper namespace="com.dtstack.assets.mapper.valid.MonitorOverviewDao">
+
+    <select id="countDefaultRule" resultType="java.lang.Long">
+        SELECT COUNT(1)
+        FROM assets_dq_monitor_rule_template
+        WHERE project_id = #{projectId}
+          AND tenant_id  = #{tenantId}
+          AND is_deleted = 0
+    </select>
+
+    <select id="countCustomRule" resultType="java.lang.Long">
+        SELECT COUNT(1)
+        FROM assets_dq_monitor_rule_custom
+        WHERE project_id = #{projectId}
+          AND tenant_id  = #{tenantId}
+          AND is_deleted = 0
+    </select>
+
+    <select id="countRuleSet" resultType="java.lang.Long">
+        SELECT COUNT(1)
+        FROM assets_dq_monitor_rule_set
+        WHERE project_id = #{projectId}
+          AND tenant_id  = #{tenantId}
+          AND is_deleted = 0
+    </select>
+
+    <select id="countMonitor" resultType="java.lang.Long">
+        SELECT COUNT(1)
+        FROM assets_dq_monitor m
+        WHERE project_id = #{projectId}
+          AND tenant_id  = #{tenantId}
+          AND is_deleted = 0
+          AND task_type  = 0
+    </select>
+
+    <select id="countPass" resultType="java.lang.Long">
+        SELECT COUNT(1)
+        FROM assets_dq_monitor_record mr
+                 INNER JOIN assets_dq_monitor m ON mr.monitor_id = m.id
+                 INNER JOIN (
+            SELECT monitor_id, MAX(id) AS max_id
+            FROM assets_dq_monitor_record
+            WHERE is_deleted = 0
+              AND status = #{passStatus}
+            GROUP BY monitor_id
+        ) latest_id ON mr.id = latest_id.max_id
+        WHERE m.project_id  = #{projectId}
+          AND m.tenant_id   = #{tenantId}
+          AND m.is_deleted  = 0
+          AND mr.is_deleted = 0
+          AND mr.status     = #{passStatus}
+    </select>
+
+    <select id="countError" resultType="java.lang.Long">
+        SELECT COUNT(1)
+        FROM assets_dq_monitor_record mr
+        INNER JOIN assets_dq_monitor m ON mr.monitor_id = m.id
+        INNER JOIN (
+        SELECT monitor_id, MAX(id) AS max_id
+        FROM assets_dq_monitor_record
+        WHERE is_deleted = 0
+        AND status IN
+        <foreach collection="errorStatus" item="s" open="(" separator="," close=")">
+            #{s}
+        </foreach>
+        GROUP BY monitor_id
+        ) latest_id ON mr.id = latest_id.max_id
+        WHERE m.project_id  = #{projectId}
+        AND m.tenant_id   = #{tenantId}
+        AND m.is_deleted  = 0
+        AND mr.is_deleted = 0
+        AND mr.status IN
+        <foreach collection="errorStatus" item="s" open="(" separator="," close=")">
+            #{s}
+        </foreach>
+    </select>
+
+    <select id="queryErrorTopRecord" resultType="com.dtstack.assets.model.valid.vo.MonitorErrorTopVO">
+        SELECT t.table_name                                                        AS tableName,
+        t.schema_name                                                       AS schemaName,
+        t.data_source_id                                                    AS dataSourceId,
+        COUNT(DISTINCT m.id)                                                AS monitorCount,
+        SUM(CASE WHEN latest.status = #{errorStatus[0]} THEN 1 ELSE 0 END) AS failedCount,
+        SUM(CASE WHEN latest.status = #{errorStatus[1]} THEN 1 ELSE 0 END) AS unPassCount,
+        MAX(latest.execute_time)                                            AS lastExecuteTime
+        FROM assets_dq_table t
+        INNER JOIN assets_dq_monitor m ON m.table_id = t.id
+        INNER JOIN (
+        SELECT mr.monitor_id, mr.status, mr.execute_time
+        FROM assets_dq_monitor_record mr
+        INNER JOIN (
+        SELECT monitor_id, MAX(id) AS max_id
+        FROM assets_dq_monitor_record
+        WHERE is_deleted = 0
+        AND status IN
+        <foreach collection="errorStatus" item="s" open="(" separator="," close=")">
+            #{s}
+        </foreach>
+        GROUP BY monitor_id
+        ) latest_id ON mr.id = latest_id.max_id
+        WHERE mr.is_deleted = 0
+        ) latest ON latest.monitor_id = m.id
+        WHERE t.project_id = #{projectId}
+        AND t.tenant_id  = #{tenantId}
+        AND t.is_deleted = 0
+        AND m.is_deleted = 0
+        AND m.task_type  = 0
+        GROUP BY t.id, t.table_name, t.schema_name, t.data_source_id
+        ORDER BY (failedCount + unPassCount) DESC,
+        lastExecuteTime DESC,
+        tableName ASC
+        LIMIT 10
+    </select>
+
+    <select id="queryRecentError" resultType="com.dtstack.assets.model.valid.vo.MonitorRecentErrorVO">
+        SELECT
+        m.id                                        AS monitorId,
+        mr.id                                       AS recordId,
+        t.table_name                                AS tableName,
+        t.schema_name                               AS schemaName,
+        m.rule_name                                 AS ruleName,
+        mr.status                                   AS status,
+        mr.monitor_type                             AS monitorType,
+        m.table_id                                  AS tableId,
+        mr.close_dirty                              AS closeDirty,
+        mr.data_source_id                           AS dataSourceId,
+        mr.data_source_type                         AS dataSourceType,
+        IFNULL(m.assets_period_type, m.period_type) AS periodType,
+        m.associated                                AS associatedVal,
+        mr.cyc_time                                 AS cycTime,
+        mr.execute_time                             AS executeTime,
+        mr.exec_end_time                            AS execEndTime
+        FROM assets_dq_monitor_record mr
+        INNER JOIN assets_dq_monitor m ON mr.monitor_id = m.id
+        INNER JOIN assets_dq_table t ON m.table_id = t.id
+        INNER JOIN (
+        SELECT monitor_id, MAX(id) AS max_id
+        FROM assets_dq_monitor_record
+        WHERE is_deleted = 0
+        AND status IN
+        <foreach collection="errorStatus" item="s" open="(" separator="," close=")">
+            #{s}
+        </foreach>
+        GROUP BY monitor_id
+        ) latest_id ON mr.id = latest_id.max_id
+        WHERE t.project_id  = #{projectId}
+        AND t.tenant_id   = #{tenantId}
+        AND t.is_deleted  = 0
+        AND m.is_deleted  = 0
+        AND m.task_type   = 0
+        AND mr.is_deleted = 0
+        AND mr.status IN
+        <foreach collection="errorStatus" item="s" open="(" separator="," close=")">
+            #{s}
+        </foreach>
+        ORDER BY mr.exec_end_time DESC
+        LIMIT 20
+    </select>
+
+    <select id="queryTableOptions" resultType="com.dtstack.assets.model.valid.vo.MonitorTableOptionVO">
+        SELECT DISTINCT
+            t.id              AS tableId,
+            t.data_source_id  AS dataSourceId,
+            t.schema_name     AS schemaName,
+            t.table_name      AS tableName
+        FROM assets_dq_table t
+                 INNER JOIN assets_dq_monitor m ON m.table_id = t.id
+        WHERE t.project_id = #{projectId}
+          AND t.tenant_id  = #{tenantId}
+          AND t.is_deleted = 0
+          AND m.is_deleted = 0
+          AND m.task_type  = 0
+        ORDER BY t.table_name
+    </select>
+
+    <select id="queryWeeklyResult" resultType="java.util.LinkedHashMap">
+        SELECT
+        DATE_FORMAT(mr.cyc_time, '%Y-%m-%d')                      AS statisticDate,
+        SUM(CASE WHEN mr.status = #{passStatus} THEN 1 ELSE 0 END)    AS passCount,
+        SUM(CASE WHEN mr.status = #{unPassStatus} THEN 1 ELSE 0 END)  AS unpassCount
+        FROM assets_dq_monitor_record mr
+        INNER JOIN assets_dq_monitor m ON mr.monitor_id = m.id
+        INNER JOIN assets_dq_table t ON m.table_id = t.id
+        INNER JOIN (
+        SELECT monitor_id, DATE(cyc_time) AS cyc_date, MAX(id) AS max_id
+        FROM assets_dq_monitor_record
+        WHERE is_deleted = 0
+        AND status IN (#{passStatus}, #{unPassStatus})
+        AND DATE(cyc_time) >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)
+        GROUP BY monitor_id, DATE(cyc_time)
+        ) latest_id ON mr.id = latest_id.max_id
+        WHERE t.project_id  = #{projectId}
+        AND t.tenant_id   = #{tenantId}
+        AND t.is_deleted  = 0
+        AND m.is_deleted  = 0
+        AND m.task_type   = 0
+        AND mr.is_deleted = 0
+        AND mr.status IN (#{passStatus}, #{unPassStatus})
+        <if test="tableId != null">
+            AND t.id = #{tableId}
+        </if>
+        GROUP BY DATE_FORMAT(mr.cyc_time, '%Y-%m-%d')
+        ORDER BY statisticDate
+    </select>
+
+    <select id="countDefaultRuleByType" resultType="java.util.LinkedHashMap">
+        SELECT
+            rule_task_type                                                              AS ruleTaskType,
+            COUNT(1)                                                                    AS ruleCount,
+            SUM(CASE WHEN relation_number IS NOT NULL AND relation_number > 0 THEN 1 ELSE 0 END) AS usageCount
+        FROM assets_dq_monitor_rule_template
+        WHERE project_id = #{projectId}
+          AND tenant_id  = #{tenantId}
+          AND is_deleted = 0
+        GROUP BY rule_task_type
+    </select>
+
+    <select id="countCustomRuleByType" resultType="java.util.LinkedHashMap">
+        SELECT
+            rule_type                                                                           AS ruleTaskType,
+            COUNT(1)                                                                            AS ruleCount,
+            SUM(CASE WHEN association_rule_count IS NOT NULL AND association_rule_count > 0 THEN 1 ELSE 0 END) AS usageCount
+        FROM assets_dq_monitor_rule_custom
