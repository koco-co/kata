+    public static String buildKeyPath(List<JsonValidationConfig> keyList) {
+        StringBuilder stringBuilder = new StringBuilder();
+        stringBuilder.append("\"");
+        for (int i = 0; i < keyList.size(); i++) {
+            String fullPath = keyList.get(i).getFullPathPoint();
+            if (i < keyList.size() - 1) {
+                stringBuilder.append(fullPath).append(";");
+            } else {
+                stringBuilder.append(fullPath);
+            }
+        }
+        return stringBuilder.append("\"").toString();
+    }
