+    /**
+     * 导出 JsonFormat 数据到 Excel (基于 EasyExcel)
+     */
+    public void exportJsonFormat(JsonFormatExportParam param, HttpServletResponse response) {
+        try {
+            // 1. 查询数据
+            List<JsonValidationConfigVo> jsonValidationConfigVos = queryTreeByJsonKey(param.getSearch(), param.getDataSourceType());
+            jsonValidationConfigVos = parseJsonChild(jsonValidationConfigVos);
+
+            // 2. 数据转换：将数据库实体转为 Excel 导出 VO
+            List<JsonFormatExportVO> exportDataList = new ArrayList<>();
+            for (JsonValidationConfigVo node : jsonValidationConfigVos) {
+                JsonFormatExportVO vo = new JsonFormatExportVO();
+                BeanUtils.copyProperties(node, vo);
+                vo.setCreateAt(DateUtil.format(node.getCreateAt(), DatePattern.NORM_DATETIME_PATTERN));
+                vo.setUpdateAt(DateUtil.format(node.getUpdateAt(), DatePattern.NORM_DATETIME_PATTERN));
+                vo.setCreateBy(node.getCreateBy());
+                vo.setUpdateBy(node.getUpdateBy());
+                vo.setDataSourceType(getDatasourceTypeName(node.getDataSourceType()));
+                vo.setLevel(convertLevel(node.getLevel()));
+                exportDataList.add(vo);
+            }
+
+            // 3. 设置响应头 (解决中文乱码问题)
+            String fileName = "json_format_" + LocalDate.now().format(DateTimeFormatter.ofPattern("yyyyMMdd"));
+            response.setContentType("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
+            response.setCharacterEncoding("utf-8");
+            // 这里 URLEncoder.encode 可以防止浏览器下载时文件名中文乱码
+            response.setHeader("Content-disposition", "attachment;filename*=utf-8''" + URLEncoder.encode(fileName + ".xlsx", "UTF-8"));
+
+            // 4. 使用 EasyExcel 写出
+            EasyExcelFactory.write(response.getOutputStream(), JsonFormatExportVO.class)
+                    .sheet("JsonFormat数据")
+                    .doWrite(exportDataList);
+
+        } catch (IOException e) {
+            response.reset();
+            response.setContentType("application/json");
+            response.setCharacterEncoding("utf-8");
+            try {
+                response.getWriter().println("{\"code\":500,\"msg\":\"导出失败：" + e.getMessage() + "\"}");
+            } catch (IOException ex) {
+                throw new BizException("导出失败：" + ex.getMessage());
+            }
+        }
+    }
