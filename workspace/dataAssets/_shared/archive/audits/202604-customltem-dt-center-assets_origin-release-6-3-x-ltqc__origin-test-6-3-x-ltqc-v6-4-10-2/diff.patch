+                LambdaQueryWrapper<JsonValidationConfig> queryWrapper = new LambdaQueryWrapper<>();
+                queryWrapper.eq(JsonValidationConfig::getId, jsonValidationConfig.getParentId());
+                queryWrapper.eq(JsonValidationConfig::getProjectId, MetaObjectHolder.projectId());
+                JsonValidationConfig parent = jsonValidationConfigDao.selectOne(queryWrapper);
+                parentFullPath = parent.getFullPath() + "['" + newJsonValidationConfig.getJsonKey() + "']";
+            }
+
+            jsonValidationConfig.setFullPath(parentFullPath); // 注意：这里设置的是fullPath字段
+
+            recursivelyUpdateFullPath(jsonValidationConfig.getId(), parentFullPath, groupedByParent);
+
+            self.updateBatchById(all);
+        }
+    }
+
+    /**
+     * 递归拼接并更新子节点的 fullPath
+     * @param currentParentId 当前正在处理的父节点ID
+     * @param parentFullPath  当前父节点更新后的完整路径 (例如: "['keys-1']['keys-2']")
+     * @param groupedByParent 按父ID分组的所有子孙节点Map
+     */
+    public void recursivelyUpdateFullPath(Long currentParentId, String parentFullPath,
+                                           Map<Long, List<JsonValidationConfig>> groupedByParent) {
+        List<JsonValidationConfig> children = groupedByParent.get(currentParentId);
+        if (children == null || children.isEmpty()) {
+            return;
+        }
+        for (JsonValidationConfig child : children) {
+            // 拼接上父节点的全路径
+            String childNewFullPath = parentFullPath + "['" + child.getJsonKey() + "']";
+            // 将拼接好的新全路径，赋值给子节点的 fullPath 字段
+            child.setFullPath(childNewFullPath);
+            child.setFullPathPoint(fullPathToPoint(childNewFullPath));
+            // 以当前子节点的新 fullPath 作为基准，继续向下递归
+            recursivelyUpdateFullPath(child.getId(), childNewFullPath, groupedByParent);
+        }
+    }
