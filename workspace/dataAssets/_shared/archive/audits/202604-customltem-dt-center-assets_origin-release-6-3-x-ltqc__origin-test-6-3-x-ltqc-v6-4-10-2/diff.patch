+
+    private String generateValueEnumRangeConditions(FunctionBO functionBO) {
+        MonitorRule rule = functionBO.getMonitorRule();
+        String columnTypeStr = rule.getColumnTypeStr();
+        Integer sourceType = functionBO.getSource().getType();
+        String columnStr = functionBO.getColumnStr();
+
+        ValueEnumRangeConfig config = (ValueEnumRangeConfig) functionConfigFactory.generateFunctionConfig(49L, functionBO.getExpansion());
