+            String selectColumnName = String.format(DIRTY_SELECT_COLUMN_ALIAS,completeTableName,column.getColumnName(),tableAlias,column.getColumnName());
+            dirtySelectColumns.add(selectColumnName);
+        });
+
+        String selectColumn = String.join(", ",dirtySelectColumns);
+        selectColumn = tableNameReplaceAlias(selectColumn,tableAliasMap);
