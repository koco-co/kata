+package com.dtstack.assets.service.valid.function.builder;
+
+import com.dtstack.assets.model.valid.dto.ReasonableMultiTableFunctionRelationTableDTO;
+import com.dtstack.assets.service.valid.function.Impl.ReasonableMultiTableColumnValueFunctionServiceImpl;
+import com.dtstack.assets.service.valid.function.config.ReasonableMultiTableColumnValueFunctionConfig;
+import com.dtstack.lang.Langs;
+import org.jetbrains.annotations.NotNull;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.StringJoiner;
+
+public class ReasonableMultiTableColumnValueSqlBuilder {
+    /**
+     * 生成用于多表校验的 FROM/JOIN 子句。
+     * 要点：
+     * 1) 主表别名：dt_main_t，来源 mainDB + mainTable
+     * 2) 关联表依次内连接：INNER JOIN schemaName.tableName dt_verify_t_${num}
+     * 3) ON 条件：通过 config.relationColumns 做 dt_main_t.k = dt_verify_t_i.k
+     */
+    public static String buildFromJoinSql(
+            ReasonableMultiTableColumnValueFunctionConfig config,
+            String mainDB,
+            String mainTable
+    ) {
+        Objects.requireNonNull(config, "config must not be null");
+        Objects.requireNonNull(mainDB, "mainDB must not be null");
+        Objects.requireNonNull(mainTable, "mainTable must not be null");
+        List<String> relationColumns = config.getRelationKeys();
+        if (relationColumns == null || relationColumns.isEmpty()) {
+            throw new IllegalArgumentException("config.relationColumns must not be empty");
+        }
+        List<ReasonableMultiTableFunctionRelationTableDTO> relationTables = config.getRelationTables();
+        StringBuilder sb = new StringBuilder();
+        sb.append(mainDB).append(".").append(mainTable)
+                .append(" ").append(ReasonableMultiTableColumnValueFunctionServiceImpl.MAIN_TABLE_ALIAS);
+        if (relationTables == null || relationTables.isEmpty()) {
+            return sb.toString();
+        }
+        for (int i = 0; i < relationTables.size(); i++) {
+            ReasonableMultiTableFunctionRelationTableDTO relationTableDTO = relationTables.get(i);
+            if (relationTableDTO == null) continue;
+            String schemaName = relationTableDTO.getSchemaName();
+            String tableName = relationTableDTO.getTableName();
+            List<String> relationTableColumns = relationTableDTO.getRelationKeys();
+            if (Langs.isBlank(schemaName) || Langs.isBlank(tableName)) {
+                throw new IllegalArgumentException("relationTables[" + i + "] schemaName/tableName must not be blank");
+            }
+
+            if (Langs.isEmpty(relationTableColumns)) {
+                throw new IllegalArgumentException("config.relationTables.relationColumns must not be empty");
+            }
+
+            if (relationTableColumns.size() != relationColumns.size()){
+                throw new IllegalArgumentException("关联表的关联字段长度不一致");
+            }
+
+            String verifyAlias = ReasonableMultiTableColumnValueFunctionServiceImpl.VERIFY_TABLE_ALIAS_PREFIX+ i;
+            StringJoiner onJoin = getTableJoinCondition(relationColumns, relationTableColumns, verifyAlias);
+            sb.append("\n INNER JOIN ")
+                    .append(schemaName).append(".").append(tableName)
+                    .append(" ").append(verifyAlias)
+                    .append(" ON ").append(onJoin);
+        }
+        return sb.toString();
+    }
+
+    @NotNull
+    private static StringJoiner getTableJoinCondition(List<String> relationColumns, List<String> relationTableColumns, String verifyAlias) {
+        StringJoiner onJoin = new StringJoiner(" AND ");
+        for (int j = 0; j< relationColumns.size(); j++) {
+            String mainTableColumn = relationColumns.get(j);
+            String relationTableColumn = relationTableColumns.get(j);
+            onJoin.add(ReasonableMultiTableColumnValueFunctionServiceImpl.MAIN_TABLE_ALIAS+"." + mainTableColumn + " = " + verifyAlias + "." + relationTableColumn);
+        }
+        // 如果 relationColumns 全是空白，避免生成错误 SQL
+        if (onJoin.length() == 0) {
+            throw new IllegalArgumentException("config.relationColumns contains only blank values");
+        }
+        return onJoin;
+    }
+}
