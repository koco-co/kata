     private String buildInitValueFilter(String verifyColumn, DataStandardAttributes standardAttribute){
         if (Langs.isBlank(standardAttribute.getValueRange().getInvalidValue()) && Langs.isBlank(standardAttribute.getValueRange().getInitValue())){
             return "";
         }
 
         StringBuilder initValueFilter = new StringBuilder();
         initValueFilter.append(" ").append("and").append(" ");
         initValueFilter.append(verifyColumn).append(" ").append("not in").append(" ");
         initValueFilter.append("(");
 
         List<String> values = new ArrayList<>();
         String vTemplate = "'%s'";
         if (Langs.isNotBlank(standardAttribute.getValueRange().getInitValue())){
             values.add(String.format(vTemplate,standardAttribute.getValueRange().getInitValue()));
         }
         if (Langs.isNotBlank(standardAttribute.getValueRange().getInvalidValue())){
             values.add(String.format(vTemplate,standardAttribute.getValueRange().getInvalidValue()));
         }
         String valueConditions = String.join(",",values);
         initValueFilter.append(valueConditions);
