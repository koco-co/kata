     public List<TableColumnStandardVO> listSearch(QueryTableColumnParam param) {
         final String search = param.getSearch();
         List<DataTableColumn> dataTableColumnList;
 
         if (StrUtil.isEmpty(search)) {
             dataTableColumnList = this.lambdaQuery().eq(DataTableColumn::getTableId, param.getTableId()).list();
         } else {
             dataTableColumnList = this.lambdaQuery().eq(DataTableColumn::getTableId, param.getTableId())
                     .and(and -> and
                             .like(DataTableColumn::getColumnName, search)
                             .or(b -> b.isNotNull(DataTableColumn::getColumnCustomDesc).like(DataTableColumn::getColumnCustomDesc, search))
                             .or(c -> c.isNull(DataTableColumn::getColumnCustomDesc).like(DataTableColumn::getColumnNameCn, search))
                     ).list();
         }
 
         if (CollUtil.isEmpty(dataTableColumnList)) {
             return ListUtil.empty();
         }
         List<Long> idList = dataTableColumnList.stream().map(DataTableColumn::getId).distinct().collect(Collectors.toList());
