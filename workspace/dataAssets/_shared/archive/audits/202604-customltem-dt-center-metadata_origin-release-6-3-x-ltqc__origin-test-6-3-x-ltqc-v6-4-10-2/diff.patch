     private String buildValueRangeFilter(String verifyColumn, DataStandardAttributes standardAttribute){
         if (Langs.isNull(standardAttribute.getValueRange())){
             return " 1=1 ";
         }
 
         if (Langs.isBlank(standardAttribute.getValueRange().getPreOperator()) && Langs.isBlank(standardAttribute.getValueRange().getPostValue())){
             return " 1=1 ";
         }
 
         StringBuilder valueRangeFilter = new StringBuilder();
 
         String preOperator = CompareOperateUtil.operateConversion(standardAttribute.getValueRange().getPreOperator());
 
         valueRangeFilter.append(verifyColumn).append(preOperator).append(standardAttribute.getValueRange().getPreValue());
 
-        if (Langs.isNotNull(standardAttribute.getValueRange().getRelationType())){
+        if (Langs.isNotNull(standardAttribute.getValueRange().getRelationType()) &&
+                (standardAttribute.getValueRange().getRelationType() == 1 || standardAttribute.getValueRange().getRelationType() == 2)){
             String relationType = standardAttribute.getValueRange().getRelationType() == 1 ? "and":"or";
             relationType = CompareOperateUtil.operateConversion(relationType);
             valueRangeFilter.append(" ").append(relationType).append(" ");
 
             String postOperator = CompareOperateUtil.operateConversion(standardAttribute.getValueRange().getPostOperator());
             valueRangeFilter.append(verifyColumn).append(postOperator).append(standardAttribute.getValueRange().getPostValue());
         }
 
         return valueRangeFilter.toString();
     }
 
+    private String buildValueRangeFilterV2(String verifyColumn, DataStandardAttributes standardAttribute) {
+        if (Langs.isNull(standardAttribute.getValueRange())) {
+            return " 1=1 ";
+        }
+
+        DataStandardValueRange valueRange = standardAttribute.getValueRange();
+        String firstCondition = buildSingleValueRangeCondition(verifyColumn, valueRange.getPreOperator(), valueRange.getPreValue());
+        String secondCondition = buildSingleValueRangeCondition(verifyColumn, valueRange.getPostOperator(), valueRange.getPostValue());
+        boolean firstExist = Langs.isNotBlank(firstCondition);
+        boolean secondExist = Langs.isNotBlank(secondCondition);
+        if (!firstExist && !secondExist) {
+            return " 1=1 ";
+        }
+
+        Integer relationType = valueRange.getRelationType();
+        if (Langs.isNull(relationType) || relationType == 0) {
+            return firstExist ? firstCondition : secondCondition;
+        }
+
+        if ((relationType == 1 || relationType == 2) && firstExist && secondExist) {
+            String relation = relationType == 1 ? "and" : "or";
+            relation = CompareOperateUtil.operateConversion(relation);
+            return firstCondition + " " + relation + " " + secondCondition;
+        }
+
+        return firstExist ? firstCondition : secondCondition;
+    }
