     private void updateStandardBindColumnCount(List<ColumnBindRecord> columnBindRecords) {
         Map<Long, List<ColumnBindRecord>> standardBindColumnMap = columnBindRecords.stream()
                 .collect(Collectors.groupingBy(ColumnBindRecord::getStandardId));
         Set<Long> standardIds = standardBindColumnMap.keySet();
         if (CollectionUtils.isNotEmpty(standardIds)) {
             List<DataStandard> dataStandards = dataStandardService.listByIds(standardIds);
             for (DataStandard dataStandard : dataStandards) {
                 Long bindCount = dataStandard.getBindCount();
                 int unBindCount = standardBindColumnMap.get(dataStandard.getId()).size();
                 dataStandard.setBindCount(bindCount <= 0 ? 0 : bindCount - unBindCount);
                 dataStandardService.updateById(dataStandard);
             }
         }
     }
 
