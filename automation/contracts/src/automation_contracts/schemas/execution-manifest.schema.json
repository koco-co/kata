{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koco.co/schemas/automation/execution-manifest.schema.json",
  "title": "Immutable automation execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logical_run_id",
    "execution_id",
    "project_id",
    "executor_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "logical_run_id": {
      "allOf": [
        {
          "$ref": "#/$defs/trimmed_non_empty_string"
        },
        {
          "pattern": "^[0-9]{8}-[0-9]{4}-(?:preflight|run|selfrun|repair|baseline)-[0-9]{2,}$"
        }
      ]
    },
    "execution_id": {
      "allOf": [
        {
          "$ref": "#/$defs/trimmed_non_empty_string"
        },
        {
          "pattern": "^execution-[0-9]{2,}$"
        }
      ]
    },
    "project_id": {
      "$ref": "#/$defs/kebab_id"
    },
    "executor_id": {
      "$ref": "#/$defs/kebab_id"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "kebab_id": {
      "allOf": [
        {
          "$ref": "#/$defs/trimmed_non_empty_string"
        },
        {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      ]
    },
    "trimmed_non_empty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "case_id", "title", "effects", "business_record"],
      "properties": {
        "feature_id": {
          "$ref": "#/$defs/kebab_id"
        },
        "case_id": {
          "allOf": [
            {
              "$ref": "#/$defs/trimmed_non_empty_string"
            },
            {
              "pattern": "^C[0-9]{4}$"
            }
          ]
        },
        "title": {
          "$ref": "#/$defs/trimmed_non_empty_string"
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform_write"],
          "properties": {
            "platform_write": {
              "type": "boolean"
            }
          }
        },
        "business_record": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["policy"],
              "properties": {
                "policy": {
                  "const": "required"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["policy", "reason"],
              "properties": {
                "policy": {
                  "const": "not_applicable"
                },
                "reason": {
                  "$ref": "#/$defs/trimmed_non_empty_string"
                }
              }
            }
          ]
        }
      }
    }
  }
}
