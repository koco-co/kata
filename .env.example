# kata 4.0.0 配置模板
# 复制为 .env 并填入实际值。.env 已在 .gitignore 中排除。

# ── 核心配置 ──
KATA_PROJECT=
KATA_TARGET_ENV=local
KATA_WORKSPACE_ROOT=workspace
KATA_LOG_LEVEL=info
KATA_TELEMETRY=off

# ── 工作区配置 ──
KATA_SOURCE_REPOS=
KATA_GIT_REMOTE_URL=
KATA_SERVER_WORKSPACE_PATH=
KATA_REPO_BRANCH_MAPPING_PATH=

# ── 钉钉通知 ──
KATA_DINGTALK_WEBHOOK_URL=
KATA_DINGTALK_KEYWORD=
KATA_DINGTALK_SIGN_SECRET=

# ── 飞书通知 ──
KATA_FEISHU_WEBHOOK_URL=

# ── 企业微信通知 ──
KATA_WECOM_WEBHOOK_URL=

# ── SMTP 邮件 ──
KATA_SMTP_HOST=
KATA_SMTP_PORT=587
KATA_SMTP_SECURE=false
KATA_SMTP_USER=
KATA_SMTP_PASS=
KATA_SMTP_FROM=
KATA_SMTP_TO=

# ── 禅道集成 ──
KATA_ZENTAO_BASE_URL=
KATA_ZENTAO_ACCOUNT=
KATA_ZENTAO_PASSWORD=

# ── 蓝湖集成 ──
KATA_LANHU_COOKIE=
KATA_LANHU_USERNAME=
KATA_LANHU_PASSWORD=
