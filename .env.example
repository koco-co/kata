# kata 4.0.0 持久配置模板
# 复制为 .env 并仅保留当前实际使用的非空项。.env 已在 .gitignore 中排除。
# 测试筛选、并发数、报告目录等单次运行开关只通过命令行进程环境传入，不持久化在这里。

# ── 核心配置 ──
KATA_ACTIVE_PROJECT=dataAssets
# 非 DataAssets 工作流的通用环境标签；DataAssets 始终以 KATA_DATAASSETS_ENV 为准。
KATA_TARGET_ENV=local
KATA_WORKSPACE_ROOT=workspace
KATA_LOG_LEVEL=info

# ── 外部源码仓库（只读）──
# 逗号分隔。`kata repos sync-env --project <name>` 只发现并验证已有外部仓库，不创建缓存。
KATA_SOURCE_REPOS=
# 必填（需要查源码时）。本机已有源码根目录；CLI 按 origin 匹配并用 git show/grep/ls-tree 只读查询。
KATA_SOURCE_REPO_ROOT=

# ── DataAssets UI 自动化 / 数据准备 ──
# 仅选择 workspace/dataAssets/_shared/env/<name>.yaml；URL、项目/数据源 ID 与 UI cookie 属于 profile。
KATA_DATAASSETS_ENV=

# ── SR3X 集成 ──
KATA_SR3X_URL=
KATA_SR3X_TYPE=
KATA_DB_URL=

# ── 基础设施只读诊断默认凭据 ──
KATA_INFRA_DEFAULT_USER=
KATA_INFRA_DEFAULT_PASSWORD=

# ── 钉钉通知 ──
KATA_DINGTALK_WEBHOOK_URL=
KATA_DINGTALK_KEYWORD=
KATA_DINGTALK_SIGN_SECRET=

# ── 飞书通知 ──
KATA_FEISHU_WEBHOOK_URL=

# ── 企业微信通知 ──
KATA_WECOM_WEBHOOK_URL=

# ── SMTP 邮件 ──
KATA_SMTP_HOST=
KATA_SMTP_PORT=587
KATA_SMTP_USER=
KATA_SMTP_PASS=
KATA_SMTP_FROM=
KATA_SMTP_TO=

# ── 禅道集成 ──
KATA_ZENTAO_BASE_URL=
KATA_ZENTAO_COOKIE=
KATA_ZENTAO_ACCOUNT=
KATA_ZENTAO_PASSWORD=

# ── 独立 DTStack CLI/SDK 运行时（不替代 DataAssets profile）──
KATA_DTSTACK_BASE_URL=
KATA_DTSTACK_SESSION_PATH=

# ── 蓝湖集成 ──
KATA_LANHU_COOKIE=
KATA_LANHU_USERNAME=
KATA_LANHU_PASSWORD=
