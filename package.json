{
  "name": "kata",
  "version": "4.0.0-alpha.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "tools/dtstack-sdk",
    ".claude/scripts/_shared"
  ],
  "description": "AI-driven QA workflows codified as reusable kata, powered by Claude Code and Codex runtime skills.",
  "author": "kata contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koco-co/kata.git"
  },
  "bugs": {
    "url": "https://github.com/koco-co/kata/issues"
  },
  "homepage": "https://github.com/koco-co/kata#readme",
  "bin": {
    "kata": ".claude/scripts/_shared/bin/kata"
  },
  "scripts": {
    "test:plugins": "bun test ./.claude/plugins",
    "test:tools": "bun test --cwd tools/dtstack-sdk",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "check:skills": "bun .claude/scripts/_shared/bin/kata skills sync-check --exit-code",
    "lint": "biome check .claude/agents .claude/skills .claude/plugins .claude/scripts tools rules",
    "format": "biome check --fix .",
    "lint:debris": "bun run .claude/scripts/lint/check-debug-files.ts && bun run .claude/scripts/lint/check-stale-paths.ts && bun run .claude/scripts/lint/check-runtime-artifacts.ts",
    "type-check": "tsc --noEmit",
    "ci": "bun run lint && bun run lint:debris && bun run lint:agents && bun run lint:paths && bun run check:skills && bun run lint:agents:codex && bun run lint:skills:codex && bun run type-check && bun run test && bun run test:plugins && bun run test:tools",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint:agents": "kata agents audit --exit-code --severity fail-only",
    "lint:agents:claude": "kata agents audit --runtime claude --exit-code --severity fail-only",
    "lint:agents:codex": "kata agents audit --runtime codex --exit-code --severity fail-only",
    "lint:skills:codex": "kata skills audit --runtime codex --exit-code",
    "lint:agents:drift": "kata agents drift --json",
    "lint:paths": "kata paths audit --exit-code",
    "lint:cases": "kata cases lint --exit-code --severity fail-only --scope workspace",
    "test:e2e:fixture": "bun test .claude/scripts/_shared/tests/e2e/case-draft-e2e.test.ts .claude/scripts/_shared/tests/e2e/runtime-invoke.test.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.9",
    "jszip": "^3.10.1",
    "nodemailer": "^8.0.7",
    "pinyin-pro": "^3.28.1",
    "sharp": "^0.34.5",
    "xmind-generator": "^1.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/cli": "0.1.13",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.41.0",
    "allure-playwright": "^3.9.0",
    "@types/nodemailer": "^8.0.0",
    "monocart-reporter": "^2.11.2",
    "typescript": "^6.0.3",
    "@types/bun": "latest"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
