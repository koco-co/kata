{
  "name": "kata",
  "version": "4.0.0-alpha.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "cli/packages/dtstack-sdk"
  ],
  "description": "AI-driven QA workflows for Claude Code and OpenAI Codex.",
  "author": "kata contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koco-co/kata.git"
  },
  "bugs": {
    "url": "https://github.com/koco-co/kata/issues"
  },
  "homepage": "https://github.com/koco-co/kata#readme",
  "bin": {
    "kata": "cli/bin/kata.ts"
  },
  "scripts": {
    "prepare": "bun scripts/setup-hooks.ts",
    "setup-hooks": "bun scripts/setup-hooks.ts",
    "pre-push": "bun scripts/pre-push.ts",
    "test:tools": "bun test --cwd cli/packages/dtstack-sdk --timeout 30000",
    "test:automation-python": "uv run --locked --no-sync pytest automation/playwright-web-ui/tests automation/playwright-web-ui/suites/data-assets/tests/contract automation/playwright-web-ui/suites/data-assets/tests/unit -q",
    "check:automation-python": "uv lock --check && uv run --locked --no-sync ruff format --check automation && uv run --locked --no-sync ruff check automation && uv run --locked --no-sync pyright",
    "check": "bun cli/bin/kata.ts repo lint --exit-code && bun cli/bin/kata.ts config validate --exit-code && bun cli/bin/kata.ts config docs --check && bun run test:knowledge-lint && bun run test:cases-lint && biome check .",
    "check:fix": "biome check --fix .",
    "type-check": "tsc --noEmit",
    "test:cases-lint": "bun cli/bin/kata.ts cases lint --all-projects --exit-code",
    "test:knowledge-lint": "bun cli/bin/kata.ts knowledge lint --all-projects --exit-code",
    "ci": "bun run check && bun run type-check && bun run test && bun run test:tools",
    "test": "bun test --timeout 30000 ./tests ./cli/lib",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.3",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "ink": "^7.1.1",
    "jszip": "^3.10.1",
    "nodemailer": "^8.0.7",
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.8",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0",
    "xmind-generator": "^1.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.18",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
