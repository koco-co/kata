{
  "name": "kata",
  "version": "4.0.0-alpha.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "cli/integrations/dtstack"
  ],
  "description": "AI-driven QA workflows for Claude Code and OpenAI Codex.",
  "author": "kata contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koco-co/kata.git"
  },
  "bugs": {
    "url": "https://github.com/koco-co/kata/issues"
  },
  "homepage": "https://github.com/koco-co/kata#readme",
  "bin": {
    "kata": "cli/bin/kata.ts"
  },
  "scripts": {
    "test:tools": "bun test --cwd cli/integrations/dtstack --timeout 30000",
    "check": "bun cli/bin/kata.ts repo lint --exit-code && biome check .",
    "check:fix": "biome check --fix .",
    "type-check": "tsc --noEmit",
    "test:workspace": "bun test --timeout 30000 ./workspace/dataAssets/_shared",
    "test:workspace-discovery": "KATA_DISCOVERY_ONLY=1 KATA_ACTIVE_PROJECT=dataAssets bunx playwright test --list",
    "test:automation-lint": "bun cli/bin/kata.ts automation lint --all-features --project dataAssets --exit-code && bun cli/bin/kata.ts automation lint --shared --project dataAssets --exit-code",
    "type-check:workspace": "tsc -p tsconfig.workspace.json --noEmit",
    "ci": "bun run check && bun run type-check && bun run type-check:workspace && bun run test:automation-lint && bun run test && bun run test:workspace && bun run test:workspace-discovery && bun run test:tools",
    "test": "bun test --timeout 30000",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "hive-driver": "^1.0.1",
    "jszip": "^3.10.1",
    "mysql2": "^3.22.3",
    "nodemailer": "^8.0.7",
    "pinyin-pro": "^3.28.1",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0",
    "xmind-generator": "^1.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/cli": "0.1.13",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.41.0",
    "allure-playwright": "^3.9.0",
    "@types/nodemailer": "^8.0.0",
    "monocart-reporter": "^2.11.2",
    "typescript": "^6.0.3",
    "@types/bun": "latest"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
