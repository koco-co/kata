{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AiCoreEnv@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KATA_PROJECT": { "type": "string", "minLength": 1 },
    "KATA_WORKSPACE": { "type": "string", "minLength": 1 },
    "KATA_TARGET_ENV": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
    "KATA_AI_CORE_ALPHA": { "type": "string", "enum": ["0", "1", "false", "true"] }
  },
  "patternProperties": {
    "^KATA_SECRET_REF_[A-Z0-9_]+$": {
      "type": "string",
      "minLength": 1,
      "pattern": "^secret://[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+$"
    }
  }
}
