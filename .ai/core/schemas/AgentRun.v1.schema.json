{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentRun@1",
  "type": "object",
  "required": [
    "run_id",
    "parent_workflow_id",
    "agent_id",
    "input_schema",
    "output_schema",
    "assigned_write_set",
    "forbidden_scope",
    "allowed_tools",
    "max_context_tokens",
    "max_output_tokens",
    "sandbox_kind",
    "apply_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "parent_workflow_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+$" },
    "input_schema": { "type": "string", "minLength": 1 },
    "output_schema": { "type": "string", "minLength": 1 },
    "assigned_write_set": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "max_context_tokens": { "type": "integer", "minimum": 1 },
    "max_output_tokens": { "type": "integer", "minimum": 1 },
    "sandbox_kind": { "type": "string", "enum": ["os_sandbox", "worktree", "read_only"] },
    "base_revision": { "type": "string", "minLength": 1 },
    "pre_run_diff_hash": { "type": "string", "minLength": 1 },
    "post_run_diff_audit": { "$ref": "DiffAudit@1" },
    "apply_policy": { "type": "string", "enum": ["parent_only_integration", "auto_commit"] },
    "cancel_policy": { "type": "string", "enum": ["cancel_on_exception", "keep_partial"] },
    "rollback_policy": { "type": "string", "enum": ["git_reset_hard", "reverse_patch", "none"] }
  }
}
