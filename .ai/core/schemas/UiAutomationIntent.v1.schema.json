{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UiAutomationIntent@1",
  "type": "object",
  "required": [
    "schema_ref",
    "request_id",
    "entry_mode",
    "project",
    "sources",
    "cases",
    "existing_artifacts",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_ref": { "type": "string", "const": "UiAutomationIntent@1" },
    "request_id": { "type": "string", "minLength": 1 },
    "entry_mode": {
      "type": "string",
      "enum": [
        "fresh_generation",
        "continue_from_plan",
        "continue_from_probe",
        "continue_from_script",
        "triage_and_repair",
        "static_review"
      ]
    },
    "project": {
      "type": "object",
      "required": ["workspace_id", "base_url", "environment_profile"],
      "additionalProperties": false,
      "properties": {
        "workspace_id": { "type": ["string", "null"] },
        "base_url": { "type": ["string", "null"] },
        "environment_profile": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "uri_or_path", "freshness"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "markdown_case",
              "archive_md",
              "prd",
              "lanhu",
              "playwright_script",
              "run_artifact",
              "natural_language"
            ]
          },
          "uri_or_path": { "type": ["string", "null"] },
          "freshness": { "type": "string", "enum": ["current", "stale", "unknown"] }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "priority",
          "intent",
          "preconditions",
          "steps",
          "assertions",
          "source_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "intent": { "type": "string", "minLength": 1 },
          "preconditions": { "$ref": "#/$defs/evidenceTextList" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["order", "action", "expected_visible_result", "evidence_status"],
              "additionalProperties": false,
              "properties": {
                "order": { "type": "integer", "minimum": 1 },
                "action": { "type": "string", "minLength": 1 },
                "expected_visible_result": { "type": ["string", "null"] },
                "evidence_status": { "$ref": "#/$defs/evidenceStatus" }
              }
            }
          },
          "assertions": { "$ref": "#/$defs/evidenceTextList" },
          "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "existing_artifacts": {
      "type": "object",
      "required": ["ui_plan", "probe_snapshot", "script_paths", "run_artifacts"],
      "additionalProperties": false,
      "properties": {
        "ui_plan": { "type": ["string", "null"] },
        "probe_snapshot": { "type": ["string", "null"] },
        "script_paths": { "type": "array", "items": { "type": "string" } },
        "run_artifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "blocks_phase"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "blocks_phase": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "evidenceStatus": {
      "type": "string",
      "enum": ["claimed", "observed", "missing", "contradicted"]
    },
    "evidenceTextList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidence_status"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "evidence_status": { "$ref": "#/$defs/evidenceStatus" }
        }
      }
    }
  }
}
