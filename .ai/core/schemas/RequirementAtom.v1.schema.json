{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RequirementAtom@1",
  "type": "object",
  "required": [
    "schema_ref",
    "id",
    "title",
    "source_refs",
    "subject",
    "evidence_kind",
    "ambiguity_class",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_ref": { "type": "string", "const": "RequirementAtom@1" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "subject": { "type": "string", "minLength": 1 },
    "condition": { "type": "string" },
    "action": { "type": "string" },
    "expected_result": { "type": "string" },
    "field_rules": { "type": "array", "items": { "type": "string" } },
    "state_rules": { "type": "array", "items": { "type": "string" } },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "data_dependencies": { "type": "array", "items": { "type": "string" } },
    "evidence_kind": { "type": "string" },
    "ambiguity_class": { "type": "string" },
    "confidence": { "type": "string" },
    "accepted_by": { "type": "string" }
  }
}
