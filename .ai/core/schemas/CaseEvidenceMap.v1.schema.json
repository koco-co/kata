{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CaseEvidenceMap@1",
  "type": "object",
  "required": ["schema_ref", "case_id", "source_refs"],
  "additionalProperties": false,
  "properties": {
    "schema_ref": { "type": "string", "const": "CaseEvidenceMap@1" },
    "id": { "type": "string" },
    "case_id": { "type": "string", "minLength": 1 },
    "coverage_matrix_ids": { "type": "array", "items": { "type": "string" } },
    "requirement_atom_ids": { "type": "array", "items": { "type": "string" } },
    "atom_ids": { "type": "array", "items": { "type": "string" } },
    "assertions": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "pending_items_in_case": { "type": "array", "items": { "type": "string" } },
    "automation_status": { "type": "string" }
  }
}
