{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ContextEnvelope@1",
  "type": "object",
  "required": ["source_ref", "trust_level", "instruction_authority", "content_format"],
  "additionalProperties": false,
  "properties": {
    "source_ref": { "$ref": "SourceRef.v1.schema.json" },
    "trust_level": {
      "type": "string",
      "enum": [
        "trusted_contract",
        "project_rule",
        "user_input",
        "external_content",
        "generated_output",
        "vendor_text",
        "memory_advisory"
      ]
    },
    "instruction_authority": { "type": "string", "enum": ["contract", "advisory", "none"] },
    "content_format": {
      "type": "string",
      "enum": ["markdown", "json", "code", "command_output", "html", "xmind_tree"]
    },
    "delimiters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "open": { "type": "string" },
        "close": { "type": "string" }
      }
    },
    "injection_scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["clean", "suspicious", "blocked"] },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
