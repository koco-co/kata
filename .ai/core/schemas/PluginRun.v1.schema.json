{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PluginRun@1",
  "type": "object",
  "required": [
    "plugin_id",
    "capability_id",
    "run_id",
    "input_path",
    "output_dir",
    "argv",
    "env_policy",
    "isolation",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "plugin_id": { "type": "string", "minLength": 1 },
    "capability_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "input_path": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string", "minLength": 1 },
    "argv": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "env_policy": {
      "type": "object",
      "required": ["secrets"],
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "string",
          "enum": ["inherit_cleartext", "strip_all", "session_resolve_only"]
        }
      }
    },
    "permission_audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fs_reads": { "type": "array", "items": { "type": "string" } },
        "fs_writes": { "type": "array", "items": { "type": "string" } },
        "network_hosts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "isolation": { "type": "string", "enum": ["hard_isolation", "best_effort_no_isolation"] },
    "timeout_ms": { "type": "integer", "minimum": 1 },
    "max_buffer_bytes": { "type": "integer", "minimum": 1 }
  }
}
