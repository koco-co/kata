{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FeatureSourceSnapshot@1",
  "type": "object",
  "required": ["schema", "feature_id", "lanhu", "confirmed_source_repos", "knowledge_refs"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "FeatureSourceSnapshot@1" },
    "feature_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "lanhu": {
      "type": "object",
      "required": ["url", "page_id"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "page_id": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "confirmed_source_repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group", "project", "branch"],
        "additionalProperties": false,
        "properties": {
          "group": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["frontend", "backend"] }
        }
      }
    },
    "knowledge_refs": { "type": "array", "items": { "type": "string" } },
    "history_refs": { "type": "array", "items": { "type": "string" } },
    "slug_source": { "type": "string" }
  }
}
