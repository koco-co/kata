{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ConfirmationQuestion@1",
  "type": "object",
  "required": [
    "schema_ref",
    "id",
    "severity",
    "location",
    "question",
    "recommended_answer",
    "basis",
    "impact_if_unanswered",
    "options",
    "affected_atoms"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_ref": { "type": "string", "const": "ConfirmationQuestion@1" },
    "id": { "type": "string", "minLength": 1 },
    "severity": { "type": "string" },
    "location": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "recommended_answer": { "type": "string", "minLength": 1 },
    "basis": { "type": "array", "items": { "type": "string" } },
    "impact_if_unanswered": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "items": { "type": "string" } },
    "affected_atoms": { "type": "array", "items": { "type": "string" } }
  }
}
