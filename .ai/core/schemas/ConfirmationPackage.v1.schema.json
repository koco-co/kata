{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ConfirmationPackage@1",
  "type": "object",
  "required": [
    "schema_ref",
    "id",
    "questions",
    "blocking_count"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_ref": { "type": "string", "const": "ConfirmationPackage@1" },
    "id": { "type": "string", "minLength": 1 },
    "module": { "type": "string" },
    "project": { "type": "string" },
    "prd_slug": { "type": "string" },
    "round": { "type": "integer", "minimum": 0 },
    "generated_at": { "type": "string" },
    "questions": { "type": "array", "items": { "type": "string" } },
    "blocking_count": { "type": "integer", "minimum": 0 },
    "defaultable_count": { "type": "integer", "minimum": 0 },
    "non_blocking_count": { "type": "integer", "minimum": 0 },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  }
}
