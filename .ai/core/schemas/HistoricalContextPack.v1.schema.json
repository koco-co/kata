{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HistoricalContextPack@1",
  "type": "object",
  "required": [
    "schema_ref",
    "id",
    "candidate_modules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_ref": { "type": "string", "const": "HistoricalContextPack@1" },
    "id": { "type": "string", "minLength": 1 },
    "module": { "type": "string" },
    "project": { "type": "string" },
    "generated_at": { "type": "string" },
    "candidate_modules": { "type": "array", "items": { "type": "string" } },
    "old_behavior": { "type": "array", "items": { "type": "string" } },
    "old_behavior_summary": { "type": "string" },
    "old_cases": { "type": "array", "items": { "type": "string" } },
    "likely_data_dependencies": { "type": "array", "items": { "type": "string" } },
    "known_pitfalls": { "type": "array", "items": { "type": "string" } },
    "repo_files_read": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  }
}
