{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SourceSnapshot@1",
  "type": "object",
  "required": ["text", "sourceRef"],
  "additionalProperties": false,
  "properties": {
    "text": { "type": "string", "minLength": 1 },
    "sourceRef": {
      "type": "string",
      "pattern": "^(?:(?:prd\\.file|command\\.output):[A-Za-z0-9][A-Za-z0-9._-]*|(?:knowledge\\.entry|repo\\.line|case\\.archive|workspace\\.config|lanhu\\.fixture):[A-Za-z0-9][A-Za-z0-9._:-]*)#sha256:[a-f0-9]{64}$"
    }
  }
}
