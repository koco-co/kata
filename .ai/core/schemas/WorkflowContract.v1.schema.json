{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WorkflowContract@1",
  "type": "object",
  "required": ["id", "schema_ref", "entry_skill", "inputs", "budgets", "steps", "failure_policy"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+$" },
    "schema_ref": { "type": "string", "const": "WorkflowContract@1" },
    "entry_skill": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+$" },
    "failure_mode": {
      "type": "string",
      "enum": ["staged_until_final_success", "keep_partial_artifacts"]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "required"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "budgets": {
      "type": "object",
      "required": ["total_run_budget_tokens", "aggregation_budget_tokens", "rate_card_ref"],
      "additionalProperties": false,
      "properties": {
        "total_run_budget_tokens": { "type": "integer", "minimum": 1 },
        "total_run_budget_usd_cents": { "type": "integer", "minimum": 0 },
        "aggregation_budget_tokens": { "type": "integer", "minimum": 0 },
        "rate_card_ref": { "type": "string", "minLength": 1 },
        "phase_token_budgets": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "repair_limits": {
          "type": "object",
          "required": [
            "max_attempts_per_spec",
            "max_locator_retries_per_spec",
            "max_user_questions_per_blocker"
          ],
          "additionalProperties": false,
          "properties": {
            "max_attempts_per_spec": { "type": "integer", "minimum": 1 },
            "max_locator_retries_per_spec": { "type": "integer", "minimum": 0 },
            "max_user_questions_per_blocker": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "uses": {
            "type": "string",
            "pattern": "^(skill|agent|plugin):[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)?@[0-9]+$"
          },
          "uses_plugin": { "type": "string", "minLength": 1 },
          "uses_agent": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+$" },
          "prompt": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+$" },
          "requires": { "type": "array", "items": { "type": "string" } },
          "condition": { "type": "string", "minLength": 1 },
          "output_schema": { "type": "string", "minLength": 1 },
          "output_slots": { "type": "array", "items": { "type": "string" } },
          "gates": { "type": "array", "items": { "type": "string" } },
          "subagent_constraints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_ref": { "type": "string" },
              "may_not_write": { "type": "array", "items": { "type": "string" } },
              "may_not_ask_user": { "type": "boolean" },
              "must_use_blocked_envelope": { "type": "boolean" },
              "readonly_safe_tools": { "type": "array", "items": { "type": "string" } },
              "forbidden_response_patterns": { "type": "array", "items": { "type": "string" } },
              "may_not_skip": { "type": "array", "items": { "type": "string" } }
            }
          },
          "routing_signals": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "indicators": { "type": "array", "items": { "type": "string" } },
                "requires_all": { "type": "boolean" },
                "behavior": { "type": "string" }
              }
            }
          },
          "iteration": {
            "type": "object",
            "required": ["max_rounds", "back_to", "scope"],
            "additionalProperties": false,
            "properties": {
              "max_rounds": { "type": "integer", "minimum": 1 },
              "back_to": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
              "scope": { "type": "string", "minLength": 1 }
            }
          },
          "input_patterns": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "output": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "object", "array"]
            }
          },
          "black_box_fixtures": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aggregation_budget_tokens": { "type": "integer", "minimum": 0 },
        "default_read_mode": { "type": "string", "minLength": 1 }
      }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_next_actors": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+$" }
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "black_box_fixtures": { "type": "array", "items": { "type": "string" } }
  }
}
