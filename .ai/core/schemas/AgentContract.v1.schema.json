{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentContract@1",
  "type": "object",
  "required": [
    "id",
    "schema_ref",
    "role",
    "runner",
    "write_capability",
    "allowed_tools",
    "read_scope",
    "forbidden_scope",
    "handoff_schema",
    "review_gates"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+$" },
    "schema_ref": { "type": "string", "const": "AgentContract@1" },
    "role": { "type": "string", "enum": ["worker", "reviewer"] },
    "runner": { "type": "string", "enum": ["worktree_patch", "read_only"] },
    "write_capability": { "type": "string", "enum": ["patch_only", "none"] },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "read_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "write_scope": { "type": "array", "items": { "type": "string" } },
    "forbidden_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "handoff_schema": { "type": "string", "const": "HandoffEnvelope@1" },
    "review_gates": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
