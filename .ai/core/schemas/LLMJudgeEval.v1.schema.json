{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LLMJudgeEval@1",
  "type": "object",
  "required": [
    "id",
    "schema_ref",
    "subject_skill",
    "input_fixture",
    "rubric",
    "judge_model",
    "samples",
    "aggregation"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+$" },
    "schema_ref": { "type": "string", "const": "LLMJudgeEval@1" },
    "subject_skill": { "type": "string", "minLength": 1 },
    "input_fixture": { "type": "string", "minLength": 1 },
    "rubric": {
      "type": "object",
      "required": ["criteria", "threshold"],
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "judge_model": {
      "type": "object",
      "required": ["provider", "model_id"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["deepseek", "anthropic"] },
        "model_id": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string", "minLength": 1 },
        "api_key_env": { "type": "string", "minLength": 1 }
      }
    },
    "samples": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
    "aggregation": { "type": "string", "enum": ["majority", "average"], "default": "majority" }
  }
}
